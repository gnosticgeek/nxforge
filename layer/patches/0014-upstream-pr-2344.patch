diff --git a/docs/reference/rendering.md b/docs/reference/rendering.md
index 0ef00c2bf8c1f2ffea950cf111721b0d0e513eee..efccbff1e84193dd4c86ec71fea827c672901e6f 100644
--- a/docs/reference/rendering.md
