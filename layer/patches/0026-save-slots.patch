From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 16:47:28 +0000
Subject: save-slots: the launcher loads a quick-save slot between the host's
 restart

With the host stopped, the slot the sidebar named in DM_LAUNCHER_SLOT_LOAD is cloned in and swapped into place (dm/mac/nxforge/launcher_slots.inc).
---
 dm/mac/launcher.c  | 7 ++++++-
 dm/mac/pack_app.py | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/dm/mac/launcher.c b/dm/mac/launcher.c
index 6d66576af8ad524f33d75dba3f581ec4b3844147..3b1e1bda1afb927b0746bc4ec286c577d85377f6 100644
--- a/dm/mac/launcher.c
+++ b/dm/mac/launcher.c
@@ -252,6 +252,8 @@ static void programs_table(const char *contents, const char *res, const char *su
     fclose(f); fclose(o); setenv("DM_PROGRAMS", out, 0);
 }
 
+#include "nxforge/launcher_slots.inc"
+
 int main(int argc, char **argv) {
     char self[PATH_MAX], exe[PATH_MAX]; uint32_t n = sizeof self;
     if (_NSGetExecutablePath(self, &n) || !realpath(self, exe)) return 1;
@@ -331,6 +333,8 @@ int main(int argc, char **argv) {
     // Restart game (Quick settings, front_mac.m front_qs_restart): the host makes this file and quits; the launcher then starts it again with the same environment
     char restart[PATH_MAX]; snprintf(restart, sizeof restart, "%s/restart-requested", sup);
     unlink(restart); setenv("DM_LAUNCHER_RESTART", restart, 1);
+    char slotreq[PATH_MAX]; snprintf(slotreq, sizeof slotreq, "%s/slot-load-requested", sup);   // quick-save slots (nxforge/launcher_slots.inc)
+    unlink(slotreq); setenv("DM_LAUNCHER_SLOT_LOAD", slotreq, 1);
     int status;
     for (;;) {
         int err = posix_spawn(&g_child, host, NULL, NULL, host_argv, environ);
@@ -339,7 +343,8 @@ int main(int argc, char **argv) {
         // Cloud saves (DM_SAVE_SYNC, dm/host/save_sync.h): what the host committed and had not sent yet goes now, after a crash too (the committed save is whole whatever the host was doing)
         // DM_SAVE as the host had it: an env file or the launch environment may have set another folder than this app's own
         if (!save_sync_after_exit(getenv("DM_SAVE"), id)) fprintf(stderr, "launcher: the save did not reach the cloud; it goes at the next start\n");
-        if (unlink(restart) || !WIFEXITED(status)) break;
+        if (unlink(restart) || !WIFEXITED(status)) { unlink(slotreq); break; }
+        slot_load(slotreq, getenv("DM_SAVE"));
         fprintf(stderr, "launcher: Restart game: starting the host again\n");
         restart_choices();
     }
diff --git a/dm/mac/pack_app.py b/dm/mac/pack_app.py
index ee3104c4a6ee4c05e8d4fce4ec539a53728dd603..8d7bebcc909cc5bc86bff6ff5e3600b2b0e3b9d0 100755
--- a/dm/mac/pack_app.py
+++ b/dm/mac/pack_app.py
@@ -329,7 +329,7 @@ def pack(a):
         if not codesign: raise SystemExit('codesign is not available')
         codesign = Path(codesign).resolve()
         minos = min_os(a.host)
-        sources = [Path(__file__).resolve(), HERE / 'launcher.c', HERE.parent / 'host/romfs_image.h', HERE.parent / 'host/save_sync.c', HERE.parent / 'host/save_sync.h', HERE.parent / 'tools/romfs.py'] + swift_sources()
+        sources = [Path(__file__).resolve(), HERE / 'launcher.c', HERE / 'nxforge/launcher_slots.inc', HERE.parent / 'host/romfs_image.h', HERE.parent / 'host/save_sync.c', HERE.parent / 'host/save_sync.h', HERE.parent / 'tools/romfs.py'] + swift_sources()
         inputs = {'options': {k: v for k, v in vars(a).items() if k != 'check'}, 'files': [(str(p), p.stat().st_mode, digest(p), os.readlink(p) if p.is_symlink() else None) for p in files + sources],
                   'trees': [(p, inventory(Path(p))) for p in (a.romfs, a.aoc, a.html, *(str(x[1]) for x in programs), *(str(x[3]) for x in programs)) if p and Path(p).exists()],
                   'tools': [[str(c), c.stat().st_mode, c.stat().st_size, c.stat().st_mtime_ns, c.stat().st_ctime_ns, run([c, '--version']).strip()] for c in (clang, swiftc)] + [
