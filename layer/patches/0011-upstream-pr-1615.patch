From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Mon, 9 Nov 2026 14:23:52 +0000
Subject: upstream-pr-1615: The GPU memory guard measures the residency set,
 not the device's allocated size

From seedds/nxnative#1615 (open; commits 174b2b6c, 3a26ebc6, fa6da9d3), taken early for Ocarina of Time
(rule 2 in UPSTREAM.md). Drop this patch when nxnative lands it.

The device's currentAllocatedSize counts every no-copy buffer whole, and several (large-pool lookup
chunks, pool-table segments, sparse-run buffers) lie over the same guest pages. Ocarina of Time on a
24 GB M4 Pro was stopped with "GPU memory is nearly full: 17582 MB of 18186 MB" while its residency set
held 6734 MB and the game's footprint was about 11.5 GB. A pending removal now also comes off what the
set holds after its next commit. DM_NVN_GUARD_DEVICE=1 keeps the old measure.
---
 dm/gfx/nvn/nvn_mtl.m     | 16 ++++++++++++++--
 docs/reference/memory.md |  2 +-
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 180a28d5462d298d0178cb0519ec68d4f6ebeb88..6415b7b2152ecda0ba1f60af4730087182c08e06 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -347,6 +347,10 @@ static void res_remove(id<MTLAllocation> r) { @autoreleasepool {
     res_q_put(r, 0);
     [g_res_objects removeObject:r];
     g_rs_rm++;
+    // what the set holds after its next commit (guard_used) leaves this out, as res_add_at counts what it adds: a load that retires and replaces buffers in one burst counted
+    // only the additions, and PRAGMATA's guard stopped the game at 5,555 MB with the committed set never past 4,220 MB (8 GB Mac)
+    { uint64_t was = atomic_load_explicit(&g_guard_set, memory_order_relaxed), sz = r.allocatedSize;
+      while (!atomic_compare_exchange_weak_explicit(&g_guard_set, &was, was > sz ? was - sz : 0, memory_order_relaxed, memory_order_relaxed)) {} }
     pthread_mutex_unlock(&g_res_mu);
 } }
 // Recycled texture memory (GitHub issues #1831, #1823). An engine that keeps its render targets in a GPU-only pool and moves or resizes them with its dynamic resolution names new
@@ -496,7 +500,14 @@ enum { GUARD_OK, GUARD_EVICT, GUARD_STOP, GUARD_WALL, GUARD_EVERY = 30, GUARD_TI
 static struct { uint64_t evict, stop, wall; } g_guard;   // bytes, all 0 with the guard off: the eviction level, the stop level, the size no commit grows past
 static _Atomic int g_guard_lv;   // the highest level met since the submit thread last looked (guard_act)
 static int guard_level(uint64_t used) { return !g_guard.stop ? GUARD_OK : used >= g_guard.wall ? GUARD_WALL : used >= g_guard.stop ? GUARD_STOP : used >= g_guard.evict ? GUARD_EVICT : GUARD_OK; }
-static uint64_t guard_used(void) { return MAX(atomic_load_explicit(&g_guard_set, memory_order_relaxed), (uint64_t)g_dev.currentAllocatedSize); }
+// What the guard measures: the residency set after its next commit (g_guard_set: its size at the last commit and what res_add added since), not the device's currentAllocatedSize.
+// The device counts every no-copy buffer whole, and with large pools in lookup chunks, pool-table segments and sparse-run buffers several of them lie over the same guest pages:
+// PRAGMATA's boot load read 8,134 MB there with the set near 3 GB on an 8 GB Mac, and the wall refused the commits its textures needed. DM_NVN_GUARD_DEVICE=1: the larger of the two
+static int g_guard_dev;   // DM_NVN_GUARD_DEVICE (guard_init)
+static uint64_t guard_used(void) {
+    uint64_t set = atomic_load_explicit(&g_guard_set, memory_order_relaxed);
+    return g_guard_dev ? MAX(set, (uint64_t)g_dev.currentAllocatedSize) : set;
+}
 static void guard_raise(int lv) { int cur = atomic_load(&g_guard_lv); while (lv > cur && !atomic_compare_exchange_weak(&g_guard_lv, &cur, lv)) {} }
 static void guard_act(uint64_t fence);
 // Applies and commits every change made before the call. A change another thread's commit took is in the set when this returns too: that commit holds g_res_commit_mu until it is
@@ -512,7 +523,7 @@ static void res_commit(void) { @autoreleasepool {
         if (lv) guard_raise(lv);
         int grew = 0; for (size_t i = 0; i < n; i++) grew |= q[i].add;
         if (lv == GUARD_WALL && grew) {
-            static uint64_t refused; if (!refused++) MLOG("[RED] GPU memory guard: %llu MB at Metal's working set of %llu MB: this residency commit and any after it that add to the set are not made", (unsigned long long)(used >> 20), (unsigned long long)(g_guard.wall >> 20));
+            static uint64_t refused; if (!refused++) MLOG("[RED] GPU memory guard: %llu MB at Metal's working set of %llu MB (residency set after this commit %llu MB, device allocated %llu MB): this residency commit and any after it that add to the set are not made", (unsigned long long)(used >> 20), (unsigned long long)(g_guard.wall >> 20), (unsigned long long)(atomic_load(&g_guard_set) >> 20), (unsigned long long)(g_dev.currentAllocatedSize >> 20));
             size_t k = 0;
             for (size_t i = 0; i < n; i++) {
                 if (!q[i].add) { q[k++] = q[i]; continue; }
@@ -763,6 +774,7 @@ static void guard_tick(void) {
     if (lv == GUARD_WALL || over >= GUARD_TICKS) guard_stop(used);
 }
 static void guard_init(void) {
+    { const char *d = getenv("DM_NVN_GUARD_DEVICE"); g_guard_dev = d && atoi(d); }
     const char *e = getenv("DM_NVN_RES_LIMIT_MB"); uint64_t ws = g_dev.recommendedMaxWorkingSetSize, lim = e ? strtoull(e, NULL, 0) << 20 : 0;
     if (!g_res) return;
     if (ws && !(e && !lim)) { g_guard.wall = MAX(ws, lim); g_guard.stop = lim ? lim : ws / 100 * 95; g_guard.evict = g_guard.stop / 95 * 80;
diff --git a/docs/reference/memory.md b/docs/reference/memory.md
index 22ebff235eedc19bd8d71ebc1f1ca9bc4933bd7b..6ad6ba4329236331302bc9c3101c1e3c39e25f04 100644
--- a/docs/reference/memory.md
+++ b/docs/reference/memory.md
@@ -535,7 +535,7 @@ The guest address space, heaps, pools, virtual address memory and the allocators
 
 - **Symptom:** a game ends stuck after `[RED] GPU out of memory`, or the Mac itself freezes until the power button; on an 8 GB Mac, WindowServer's watchdog restarts the desktop. Now: `[RED] GPU memory guard: ... stopping the game before the driver cannot wire more`, the report of what the residency set holds, and an alert before the app quits.
 - **Cause:** GPU memory is wired, and the driver refuses to wire past `recommendedMaxWorkingSetSize`: IOGPUScheduler's `freeToWireMemory` fails there (aCidcOde, GitHub issue #1326). The submit thread then waits in the kernel, where the process cannot be killed: 7 minutes in that report. Nothing in the host looked at the working set.
-- **Fix:** `res_commit` (`nvn_mtl.m`) looks before each commit, at the larger of what the commit would leave and the device's `currentAllocatedSize`. The set's `allocatedSize` leaves out what was never committed (measured: +0 MB for a new 64 MB texture until its commit), so what `res_add` added since counts too. The device's size counts a resource from its creation, in a set or not.
+- **Fix:** `res_commit` (`nvn_mtl.m`) looks before each commit, at what the set holds after it: its size at the last commit, plus what `res_add` added and less what `res_remove` took out since (`g_guard_set`). Not the device's `currentAllocatedSize`, which counts every no-copy buffer whole: where several lie over the same guest pages (a large pool's chunks and table segments), PRAGMATA's boot read 8,134 MB there with the set near 3 GB, and the wall refused the commits its textures needed (`DM_NVN_GUARD_DEVICE=1` takes the larger of the two again). Before the removals came off, a load that retired and replaced buffers in one burst looked like growth only: the guard stopped PRAGMATA at 5,555 MB with the committed set never past 4,220 MB. The set's `allocatedSize` leaves out what was never committed (measured: +0 MB for a new 64 MB texture until its commit), so what `res_add` added since counts too. The device's size counts a resource from its creation, in a set or not.
   - From 80% of the working set the submit thread lets go of what can go, at most every 30 frames (`guard_evict`): idle sharing entries nothing holds, finished deferred releases, finished spares, the staging the upload slots keep.
   - From 95% it first waits for that to land, then looks again. Still over: `guard_stop` logs the report (by kind, distinct pages under the shared buffers, textures by format, the largest objects) and calls `front_gpu_memory_stop`. The Mac app closes the graphics gate (`dm_gfx_suspend`), so no more GPU work grows what is held, leaves full screen, shows an alert and quits as ⌘Q does, so the launcher's work after the game runs. Without a window the host takes its graceful exit.
   - A commit that adds to the set is not made at all at the working set itself. Commits that only remove go through.
