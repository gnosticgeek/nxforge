+// NXForge: the memory the host's rules plan for (the Memory setting; from Fasen24-AI/swordboiMacNative 790245d6 and d343de61, by EmmanueleC, MIT): Metal's working set for this
+// device, or less when the player says so (DM_MEMORY_GB=<GB>: the working set of a device with that much memory, taken as 0.74 of it, which is what a 24 GB Mac reports). The rules
+// that read it: where the memory guard begins to let go (guard_init), how many textures are made ahead of their first read (pool_budget) and from when read marks age
+// (seen_cap_kb). Where the guard stops the game stays the device's own limit: a player who leaves room for other apps is not asking for the game to end sooner. A value at or over
+// the device's own changes nothing
+static uint64_t rule_ws(void) {
+    static uint64_t v; if (v) return v;
+    uint64_t ws = g_dev.recommendedMaxWorkingSetSize; const char *e = getenv("DM_MEMORY_GB");
+    if (e && *e && strcmp(e, "auto")) {
+        double gb = atof(e);
+        if (!(gb >= 4 && gb <= 512)) MLOG("[RED] DM_MEMORY_GB=%s: auto, or a number of GB from 4 to 512; planning for this device's own memory", e);
+        else { uint64_t d = (uint64_t)(gb * 0.74 * 1024) << 20;
+            if (d < ws) { MLOG("memory: planning for a device with %g GB (DM_MEMORY_GB): a working set of %llu MB instead of this device's %llu MB", gb, (unsigned long long)(d >> 20), (unsigned long long)(ws >> 20)); ws = d; }
+            else MLOG("memory: DM_MEMORY_GB=%s is not under this device's own (working set %llu MB): nothing changes", e, (unsigned long long)(ws >> 20)); }
+    }
+    return v = ws;
+}
 // GPU memory guard. GPU memory is wired, and the driver refuses to wire past Metal's working set (recommendedMaxWorkingSetSize: IOGPUScheduler freeToWireMemory fails there). The submit thread
 // then waits in the kernel, where nothing can kill the process: GitHub issue #1326 ended with a Mac frozen until the power button, PR #1319's 8 GB Mac with WindowServer's watchdog. So every commit
 // of the residency set looks first, at the larger of what the commit would leave (the set's allocatedSize, which counts only what was committed, and what was added since) and the device's
@@ -1262,7 +1279,7 @@ static void guard_init(void) {
     { const char *d = getenv("DM_NVN_GUARD_DEVICE"); g_guard_dev = d && atoi(d); }
     const char *e = getenv("DM_NVN_RES_LIMIT_MB"); uint64_t ws = g_dev.recommendedMaxWorkingSetSize, lim = e ? strtoull(e, NULL, 0) << 20 : 0;
     if (!g_res) return;
-    if (ws && !(e && !lim)) { g_guard.wall = MAX(ws, lim); g_guard.stop = lim ? lim : ws / 100 * 95; g_guard.evict = g_guard.stop / 95 * 80;
+    if (ws && !(e && !lim)) { g_guard.wall = MAX(ws, lim); g_guard.stop = lim ? lim : ws / 100 * 95; g_guard.evict = lim ? g_guard.stop / 95 * 80 : rule_ws() / 100 * 80;   // NXForge: letting go begins by what the player plans for (rule_ws), stopping by the device
 #if TARGET_OS_IPHONE
         if (!lim) g_guard.stop = g_guard.wall = UINT64_MAX;
 #endif
