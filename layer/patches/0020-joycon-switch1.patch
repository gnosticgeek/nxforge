diff --git a/dm/host/nxforge/front_mac_joycon1.inc b/dm/host/nxforge/front_mac_joycon1.inc
new file mode 100644
index 0000000000000000000000000000000000000000..bc159399fa18d7cf15227ca3e5ecba7aa31fb602
--- /dev/null
+++ b/dm/host/nxforge/front_mac_joycon1.inc
@@ -0,0 +1,188 @@
+// NXForge: included by front_mac.m before pad_set (it shares that file's statics). Kept out of upstream's file so a merge of nxnative meets one #include line.
+// Switch 1 Joy-Cons as Joy-Cons, each with its own motion sensor.
+// macOS (checked on 27.2) joins a left and a right Joy-Con into one GameController controller, product category "Nintendo Switch Joy-Con (L/R)", with an extended gamepad and no
+// GCMotion at all. Its HID devices (Nintendo 0x057E, left 0x2006, right 0x2007) send report 0x30 about 75 times a second, but the six-axis bytes are zero: macOS leaves the
+// sensors off. One subcommand turns them on (output report 0x01, neutral rumble, subcommand 0x40 argument 0x01); the Joy-Con answers with report 0x21 and its 0x30 reports carry
+// three samples each, laid out as the Pro Controller's (motion_pro.h decodes them). The right Joy-Con's sensor is turned half round its long axis: lying flat, face up, its raw z
+// reads -1 G where the left one reads +1 G; standing on its rail end both read +1 G on x. So its y and z are negated, which in the decoded Switch frame is x and z of both the
+// acceleration and the rotation (measured on Tom's pair, 2026-11-13).
+// The pair's player gets the Joy-Con styles (dm_joy_attach: JoyDual where the game supports it, a sensor per Joy-Con), each half's own buttons and stick (dm_joy_set), and the
+// right Joy-Con's motion also as the controller's (dm_motion_set_hid) for a game that sees a Pro-style pad. A single Joy-Con (GameController's sideways layout) stays a
+// Pro-style pad for now. With two pairs connected, GameController cannot say which HID device is whose, so neither pair gets motion (logged).
+// DM_JOY1=0 turns all of this off (the pair plays as one Pro-style pad with no motion, as before); DM_MOTION=0 or DM_MOTION_HID=0 keep the sensors off.
+typedef struct joy1_dev { IOHIDDeviceRef hid; int side; uint8_t report[512]; pro_motion motion; uint64_t heard, data_at, enabled_at; int enables; uint8_t counter; struct joy1_dev *next; } joy1_dev;
+static IOHIDManagerRef g_j1_mgr;
+static CFRunLoopRef g_j1_loop;   // the Joy-Cons' own thread (nxf_joy1_start): their reports are not held up while the main thread is busy drawing
+// Everything that touches the devices or the routing runs on that thread; the main thread hands its part over here (inline before the thread exists)
+static void joy1_post(void (^b)(void)) {
+    if (!g_j1_loop) { b(); return; }
+    CFRunLoopPerformBlock(g_j1_loop, kCFRunLoopCommonModes, b); CFRunLoopWakeUp(g_j1_loop);
+}
+static joy1_dev *g_j1_devs;
+static int g_j1_on = -1, g_j1_active = 1, g_j1_motion;
+static uint32_t g_j1_sides[DM_PLAYERS];   // the Joy-Cons each player's GameController controller holds: 1 left, 2 right
+static int g_j1_owner[2] = {-1, -1}, g_j1_logged[2] = {-2, -2};   // the player each side's sensor goes to (-1: none, or not one unambiguous one)
+// Buttons straight from the HID reports (joy1_report, on the Joy-Cons' thread). GameController hands a press to the main thread, where it waits behind whatever that thread is
+// doing; the same press is in the 0x30 report this thread already reads for the sensor. While a side's reports are live its buttons come from them, its stick stays
+// GameController's (calibrated). The whole-controller state a Pro-style game reads (dm_pad_set_player) is GameController's as before.
+static _Atomic uint64_t g_j1_hid_btn[2], g_j1_hid_at[2], g_j1_hid_changed[2];   // per side: the buttons in its last report, when that report came, when they last changed
+static _Atomic uint64_t g_j1_stick[DM_PLAYERS][2];   // per player and side: GameController's stick, x in the high half
+static uint64_t g_j1_gc_btn[2]; static uint64_t g_j1_lag_n, g_j1_lag_sum, g_j1_lag_max;   // main thread: how much later GameController brought the same change
+static uint64_t joy1_buttons(int side, const uint8_t *r) {
+    uint8_t own = r[side ? 3 : 5], sh = r[4]; uint64_t m = 0;
+    if (side) {
+        if (own & 0x01) m |= DM_BTN_Y; if (own & 0x02) m |= DM_BTN_X; if (own & 0x04) m |= DM_BTN_B; if (own & 0x08) m |= DM_BTN_A;
+        if (own & 0x40) m |= DM_BTN_R; if (own & 0x80) m |= DM_BTN_ZR; if (sh & 0x02) m |= DM_BTN_PLUS; if (sh & 0x04) m |= DM_BTN_RS;
+    } else {
+        if (own & 0x01) m |= DM_BTN_DOWN; if (own & 0x02) m |= DM_BTN_UP; if (own & 0x04) m |= DM_BTN_RIGHT; if (own & 0x08) m |= DM_BTN_LEFT;
+        if (own & 0x40) m |= DM_BTN_L; if (own & 0x80) m |= DM_BTN_ZL; if (sh & 0x01) m |= DM_BTN_MINUS; if (sh & 0x08) m |= DM_BTN_LS;
+    }
+    return m;
+}
+static int joy1_hid_live(int side, uint64_t now) { uint64_t at = atomic_load(&g_j1_hid_at[side]); return at && now - at < 200000000ull; }
+static int joy1_on(void) { if (g_j1_on < 0) { const char *e = getenv("DM_JOY1"); g_j1_on = !e || atoi(e); } return g_j1_on; }
+static uint32_t joy1_sides_of(GCController *c) { return [c.productCategory isEqualToString:@"Nintendo Switch Joy-Con (L/R)"] ? 3u : 0u; }
+static void joy1_route(void) {
+    uint64_t now = now_ns();
+    for (int s = 0; s < 2; s++) {
+        int owner = -1, holders = 0, live = 0;
+        for (int p = 0; p < DM_PLAYERS; p++) if (g_j1_sides[p] >> s & 1) { owner = p; holders++; }
+        for (joy1_dev *d = g_j1_devs; d; d = d->next) if (d->side == s && pro_live(d->heard, now)) live++;
+        int o = holders == 1 && live <= 1 ? owner : -1;
+        if (o != g_j1_owner[s] && g_j1_owner[s] >= 0) { dm_motion_clear_joy(g_j1_owner[s], s); dm_motion_clear_hid(g_j1_owner[s]); }
+        if (o != g_j1_owner[s]) for (joy1_dev *d = g_j1_devs; d; d = d->next) if (d->side == s) { d->motion = (pro_motion){0}; d->enables = 0; }
+        g_j1_owner[s] = o;
+        if (o != g_j1_logged[s] && (holders || live)) {
+            g_j1_logged[s] = o;
+            if (o >= 0) LOG("[joycon] %s Joy-Con: motion to player %d%s", s ? "right" : "left", o + 1, g_j1_motion ? "" : " (motion off)");
+            else LOG("[joycon] %s Joy-Con: %d controllers hold one, %d HID devices report: cannot pair them uniquely, no motion", s ? "right" : "left", holders, live);
+        }
+    }
+}
+// Output report 0x01: a packet counter, the neutral rumble of both motors, subcommand 0x40 (six-axis sensor) with 0x01 (on)
+static void joy1_enable(joy1_dev *d, uint64_t now) {
+    uint8_t r[49] = {0x01, (uint8_t)(d->counter++ & 0xF), 0x00, 0x01, 0x40, 0x40, 0x00, 0x01, 0x40, 0x40, 0x40, 0x01};
+    IOReturn e = IOHIDDeviceSetReport(d->hid, kIOHIDReportTypeOutput, r[0], r, sizeof r);
+    d->enabled_at = now; d->enables++;
+    if (e != kIOReturnSuccess) LOG("[RED] [joycon] %s Joy-Con: turning its sensor on failed (IOReturn 0x%x)", d->side ? "right" : "left", e);
+    else LOG("[joycon] %s Joy-Con: sensor turned on (try %d)", d->side ? "right" : "left", d->enables);
+}
+static void joy1_report(void *ctx, IOReturn result, void *sender, IOHIDReportType type, uint32_t id, uint8_t *r, CFIndex len) {
+    (void)sender;
+    joy1_dev *d = ctx;
+    if (result != kIOReturnSuccess || type != kIOHIDReportTypeInput || id != 0x30 || len < 49) return;
+    uint64_t now = now_ns(); int was = pro_live(d->heard, now); d->heard = now;
+    if (!was) joy1_route();
+    int p = g_j1_owner[d->side];
+    if (!g_j1_motion || p < 0) return;
+    if (g_j1_active) {
+        uint64_t m = joy1_buttons(d->side, r), st = atomic_load(&g_j1_stick[p][d->side]);
+        if (atomic_exchange(&g_j1_hid_btn[d->side], m) != m) atomic_store(&g_j1_hid_changed[d->side], now);
+        atomic_store(&g_j1_hid_at[d->side], now);
+        dm_joy_set(p, d->side, m, (int32_t)(st >> 32), (int32_t)(uint32_t)st);
+    }
+    int data = 0; for (int i = 13; i < 49 && !data; i++) data = r[i] != 0;
+    if (data) d->data_at = now;
+    else {   // its sensor is off: on now, again every 2 s while it stays off (macOS may turn it off at a reconnect), five times at most
+        if ((!d->enabled_at || now - d->enabled_at > 2000000000ull) && d->enables < 5) joy1_enable(d, now);
+        else if (d->enables == 5) { d->enables++; LOG("[RED] [joycon] %s Joy-Con: its sensor stays off after 5 tries", d->side ? "right" : "left"); }
+        return;
+    }
+    if (!g_j1_active) return;
+    pro_motion_sample s[3]; int n = pro_motion_decode(&d->motion, r, (size_t)len, now, s);
+    for (int i = 0; i < n; i++) {
+        if (d->side) { s[i].acc[0] = -s[i].acc[0]; s[i].acc[2] = -s[i].acc[2]; s[i].rot[0] = -s[i].rot[0]; s[i].rot[2] = -s[i].rot[2]; }
+        dm_motion_set_joy(p, d->side, s[i].acc, s[i].rot, s[i].ns);
+        if (d->side == 1 || g_j1_owner[1] != p) dm_motion_set_hid(p, s[i].acc, s[i].rot, s[i].ns);   // the whole controller's sensor: the right Joy-Con's, as a Joy-Con 2 pair's
+    }
+}
+static void joy1_found(void *ctx, IOReturn result, void *sender, IOHIDDeviceRef hid) {
+    (void)ctx; (void)sender;
+    if (result != kIOReturnSuccess || IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDGCSyntheticDeviceKey)) == kCFBooleanTrue) return;
+    for (joy1_dev *d = g_j1_devs; d; d = d->next) if (d->hid == hid) return;
+    joy1_dev *d = calloc(1, sizeof *d); if (!d) return;
+    d->hid = (IOHIDDeviceRef)CFRetain(hid); d->side = [(__bridge NSNumber *)IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDProductIDKey)) intValue] == 0x2007;
+    d->next = g_j1_devs; g_j1_devs = d;
+    IOHIDDeviceRegisterInputReportCallback(hid, d->report, sizeof d->report, joy1_report, d);
+    joy1_route();
+}
+static void joy1_removed(void *ctx, IOReturn result, void *sender, IOHIDDeviceRef hid) {
+    (void)ctx; (void)result; (void)sender;
+    joy1_dev **link = &g_j1_devs;
+    while (*link && (*link)->hid != hid) link = &(*link)->next;
+    if (!*link) return;
+    joy1_dev *d = *link; *link = d->next;
+    IOHIDDeviceRegisterInputReportCallback(hid, d->report, sizeof d->report, NULL, NULL);   // while its buffer still exists; the Joy-Con thread's run loop serializes this with its reports
+    CFRelease(d->hid); free(d);
+    joy1_route();
+}
+static void nxf_joy1_start(void) {
+    if (!joy1_on()) { LOG("[joycon] Switch Joy-Cons play as a Pro-style pad (DM_JOY1=0)"); return; }
+    const char *e = getenv("DM_MOTION"), *h = getenv("DM_MOTION_HID");
+    g_j1_motion = !(e && !atoi(e)) && !(h && !atoi(h));
+    if (!g_j1_motion) return;
+    g_j1_mgr = IOHIDManagerCreate(kCFAllocatorDefault, kIOHIDOptionsTypeNone); if (!g_j1_mgr) return;
+    IOHIDManagerSetDeviceMatchingMultiple(g_j1_mgr, (__bridge CFArrayRef)@[@{@kIOHIDVendorIDKey: @0x057E, @kIOHIDProductIDKey: @0x2006}, @{@kIOHIDVendorIDKey: @0x057E, @kIOHIDProductIDKey: @0x2007}]);
+    IOHIDManagerRegisterDeviceMatchingCallback(g_j1_mgr, joy1_found, NULL);
+    IOHIDManagerRegisterDeviceRemovalCallback(g_j1_mgr, joy1_removed, NULL);
+    // Their own thread at the input QoS: on the main run loop a report waits behind whatever the main thread is doing (a frame, a window event), and a swing's samples arrive
+    // late and bunched. The thread opens the manager and runs its loop for the life of the process; the main thread waits for the open's answer
+    dispatch_semaphore_t opened = dispatch_semaphore_create(0); __block IOReturn r = kIOReturnError;
+    NSThread *t = [[NSThread alloc] initWithBlock:^{
+        CFRunLoopRef loop = CFRunLoopGetCurrent();
+        IOHIDManagerScheduleWithRunLoop(g_j1_mgr, loop, kCFRunLoopDefaultMode);
+        r = IOHIDManagerOpen(g_j1_mgr, kIOHIDOptionsTypeNone);   // not exclusive: GameController keeps the buttons
+        if (r != kIOReturnSuccess) { IOHIDManagerUnscheduleFromRunLoop(g_j1_mgr, loop, kCFRunLoopDefaultMode); dispatch_semaphore_signal(opened); return; }
+        g_j1_loop = (CFRunLoopRef)CFRetain(loop);
+        dispatch_semaphore_signal(opened);
+        for (;;) CFRunLoopRun();
+    }];
+    t.name = @"joycon-hid"; t.qualityOfService = NSQualityOfServiceUserInteractive; [t start];
+    dispatch_semaphore_wait(opened, DISPATCH_TIME_FOREVER);
+    if (r != kIOReturnSuccess) {
+        LOG("[RED] [joycon] cannot open the Joy-Cons' HID devices (0x%x): no Joy-Con motion", r);
+        CFRelease(g_j1_mgr); g_j1_mgr = NULL; g_j1_motion = 0;
+    }
+}
+// A GameController controller took player p (pads_changed, pad_read's press to join): a Joy-Con pair is shown to the game as Joy-Cons
+static void nxf_joy1_attach(GCController *c, int p) {
+    if (!joy1_on() || p < 0 || p >= DM_PLAYERS) return;
+    uint32_t s = joy1_sides_of(c); if (!s || g_j1_sides[p] == s) return;
+    g_j1_sides[p] = s; dm_joy_attach(p, s); joy1_post(^{ joy1_route(); });
+    LOG("[joycon] '%s': player %d is a Joy-Con pair to the game", c.vendorName.UTF8String ?: "?", p + 1);
+}
+static void nxf_joy1_detach(int p) {
+    if (p < 0 || p >= DM_PLAYERS || !g_j1_sides[p]) return;
+    g_j1_sides[p] = 0;
+    for (int s = 0; s < 2; s++) { dm_joy_set(p, s, 0, 0, 0); dm_motion_clear_joy(p, s); }
+    dm_joy_attach(p, 0); joy1_post(^{ joy1_route(); });
+}
+// Each half's own buttons and stick (hle_hid.c fill_joy); the whole controller's state goes on through dm_pad_set_player as before
+static void nxf_joy1_set(int p, uint64_t m, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
+    if (p < 0 || p >= DM_PLAYERS || !g_j1_sides[p]) return;
+    const uint64_t left = DM_BTN_LEFT | DM_BTN_UP | DM_BTN_RIGHT | DM_BTN_DOWN | DM_BTN_L | DM_BTN_ZL | DM_BTN_MINUS | DM_BTN_LS;
+    const uint64_t right = DM_BTN_A | DM_BTN_B | DM_BTN_X | DM_BTN_Y | DM_BTN_R | DM_BTN_ZR | DM_BTN_PLUS | DM_BTN_RS;
+    uint64_t now = now_ns(), want[2] = {m & left, m & right}; int32_t sx[2] = {lx, rx}, sy[2] = {ly, ry};
+    for (int s = 0; s < 2; s++) {
+        atomic_store(&g_j1_stick[p][s], (uint64_t)(uint32_t)sx[s] << 32 | (uint32_t)sy[s]);
+        int live = g_j1_owner[s] == p && joy1_hid_live(s, now);
+        if (live && want[s] != g_j1_gc_btn[s] && want[s] == atomic_load(&g_j1_hid_btn[s])) {   // the change the report already brought: how much later it is here
