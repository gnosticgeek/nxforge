--- a/scripts/build_ipa_from_nsp.py
+++ b/scripts/build_ipa_from_nsp.py
@@ -3292,6 +3292,24 @@ def drop_prewarm(pso):   # the prewarm pipelines in an archive folder, with thei
     (pso / 'prewarm.tsv').unlink(missing_ok=True)
 
 
+def played_pipelines(g, text, manifest, work):
+    """NXForge: the pipelines this Mac's player built at a draw (the R and M rows of ~/Library/Application Support/nxnative/<id>/pso_user.tsv, the launcher's DM_PSO_USER) join the
+    profile's prewarm list for --prebake, so a rebuilt app has them in its bundle instead of compiling them mid-play again. Rows the profile already lists are not repeated; the list
+    goes in the work folder (the profile's own file is left as it is). NXFORGE_PLAYED_PIPELINES=off: the profile's list alone, as nxnative builds it. Returns (text, manifest path)"""
+    if os.environ.get('NXFORGE_PLAYED_PIPELINES', '').lower() in ('0', 'off', 'no', 'false'): return text, manifest
+    user = Path.home() / 'Library/Application Support/nxnative' / g.id / 'pso_user.tsv'
+    try: played = user.read_text(errors='replace').splitlines() if user.is_file() else []
+    except OSError: played = []
+    have = set(text.splitlines())
+    extra = list(dict.fromkeys(ln for ln in played if ln.startswith(('R\t', 'M\t')) and ln not in have))
+    if not extra: return text, manifest
+    merged = text + ('' if not text or text.endswith('\n') else '\n') + f'# NXForge: {len(extra):,} pipelines this Mac\'s player built at a draw ({user})\n' + ''.join(f'{ln}\n' for ln in extra)
+    out = work / 'pso/played_manifest.tsv'; out.parent.mkdir(parents=True, exist_ok=True)
+    if not out.is_file() or out.read_text() != merged: out.write_text(merged)
+    say(f'prewarm pipelines: {len(extra):,} more that this Mac\'s player built at a draw (NXFORGE_PLAYED_PIPELINES=off leaves them out)')
+    return merged, out
+
+
 def mac_prebake(py, repo, work, msl, g, host, pso, env, logs):
     """PLATFORM 'mac-app', --prebake (on by default): what the app's first start would still build after the pipeline archive, made here and added to the archive folder pso, so the first
     start finds it (nvn_mtl.m pso_bundle_open_prewarm) instead of building it before the first frame: the prewarm list's pipelines (pso_manifest.tsv: the R rows' bases with a vertex layout,
@@ -3305,6 +3323,7 @@ def mac_prebake(py, repo, work, msl, g, host, pso, env, logs):
     if pso is None: return pso   # no pair archive (none for this Mac's GPU, or --gpu none): the app has no bundle to put them in
     manifest = g.table('pso_manifest.tsv')
     text = manifest.read_text() if manifest.is_file() else ''
+    text, manifest = played_pipelines(g, text, manifest, work)
     rows = sum(ln.startswith(('R\t', 'M\t')) for ln in text.splitlines())
     def none(why):   # the app goes without them: none of an earlier build's stay in pso (pso_offline.py leaves an architecture's there)
         say(why); drop_prewarm(pso); return pso
