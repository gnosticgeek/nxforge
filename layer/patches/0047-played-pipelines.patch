--- /dev/null
+++ b/dm/tools/tests/test_nsp_played_pipelines.py
@@ -0,0 +1,53 @@
+"""NSP script, NXForge: the player's own pipeline list (pso_user.tsv) joins the profile's prewarm list for --prebake (played_pipelines). No game files needed."""
+import importlib.util
+import os
+from pathlib import Path
+import shutil
+import tempfile
+import types
+import unittest
+from unittest import mock
+
+REPO = Path(__file__).resolve().parents[3]
+spec = importlib.util.spec_from_file_location('build_ipa_from_nsp', REPO / 'scripts/build_ipa_from_nsp.py')
+assert spec and spec.loader
+nsp = importlib.util.module_from_spec(spec); spec.loader.exec_module(nsp)
+
+PROFILE = '# list\nR\taaa\nC\tbbb\n'
+USER = 'S\tshader\nR\taaa\nR\tccc\nM\tddd\nR\tccc\n'
+
+
+class Played(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp()); self.addCleanup(shutil.rmtree, self.tmp)
+        self.home, self.work = self.tmp / 'home', self.tmp / 'X_build'
+        self.user = self.home / 'Library/Application Support/nxnative/0100ABCD00000000/pso_user.tsv'
+        self.user.parent.mkdir(parents=True); self.work.mkdir()
+        self.g, self.manifest = types.SimpleNamespace(id='0100ABCD00000000'), self.tmp / 'pso_manifest.tsv'
+        self.manifest.write_text(PROFILE)
+        p = mock.patch.object(Path, 'home', return_value=self.home); p.start(); self.addCleanup(p.stop)
+        q = mock.patch.object(nsp, 'say', lambda *a, **k: None); q.start(); self.addCleanup(q.stop)
+
+    def test_new_rows_are_added_once(self):
+        self.user.write_text(USER)
+        text, path = nsp.played_pipelines(self.g, PROFILE, self.manifest, self.work)
+        self.assertEqual(path, self.work / 'pso/played_manifest.tsv')
+        self.assertEqual(path.read_text(), text)
+        self.assertTrue(text.startswith(PROFILE))
+        added = [ln for ln in text[len(PROFILE):].splitlines() if not ln.startswith('#')]
+        self.assertEqual(added, ['R\tccc', 'M\tddd'])
+        self.assertEqual(self.manifest.read_text(), PROFILE)   # the profile's own list is left alone
+
+    def test_nothing_played(self):
+        self.assertEqual(nsp.played_pipelines(self.g, PROFILE, self.manifest, self.work), (PROFILE, self.manifest))
+        self.user.write_text('S\tonly shaders\nR\taaa\n')
+        self.assertEqual(nsp.played_pipelines(self.g, PROFILE, self.manifest, self.work), (PROFILE, self.manifest))
+
+    def test_off(self):
+        self.user.write_text(USER)
+        with mock.patch.dict(os.environ, {'NXFORGE_PLAYED_PIPELINES': 'off'}):
+            self.assertEqual(nsp.played_pipelines(self.g, PROFILE, self.manifest, self.work), (PROFILE, self.manifest))
+
+
+if __name__ == '__main__':
+    unittest.main()
