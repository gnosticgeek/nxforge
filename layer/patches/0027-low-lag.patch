From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 22:42:50 +0000
Subject: low-lag: direct presents in a window while the game has headroom

In a window the display link calls back about 50 ms before its target display time,
so a frame is on screen 66 ms after the game presents it; pacing mode 0 (the present
thread takes its own drawables, as in fullscreen on a Mac) shows it after 35 ms, and
holds 60 only while the game has headroom. nxforge/low_lag.h chooses per frame.
The hooks: hle_nvn.c nvnQueuePresentTexture feeds it, nvn_mtl.m link_sync asks it.
---
 dm/gfx/nvn/hle_nvn.c  | 2 ++
 dm/gfx/nvn/nvn_mtl.m  | 6 +++++-
 dm/gfx/tests/Makefile | 2 ++
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/dm/gfx/nvn/hle_nvn.c b/dm/gfx/nvn/hle_nvn.c
index 624e12d42693fd9bfcc047a88631b5dbd38ba729..6367cda7a4c755a68966d329710059594b3b0a88 100644
--- a/dm/gfx/nvn/hle_nvn.c
+++ b/dm/gfx/nvn/hle_nvn.c
@@ -1854,6 +1854,7 @@ static int link_wait(const win_t *o, uint64_t timeout_ns);
 __attribute__((weak)) void dm_main_yield_stats(uint64_t *n, uint64_t *ns) { *n = 0; *ns = 0; }   // The host's hle_thread.c provides the ground truth; 0 in graphics unit tests
 __attribute__((weak)) uint32_t dm_guest_work_qos(unsigned *count) { if (count) *count = 0; return QOS_CLASS_UNSPECIFIED; }
 int mtl_probe_ramp_on(void);   // nvn_mtl.m: DM_FSTEP_PROBE_RAMP (default on; ab with DM_AB)
+void mtl_low_lag_tick(uint64_t start_ns, int k);   // NXForge: nvn_mtl.m (nxforge/low_lag.inc)
 int mtl_fstep_settle(void);    // nvn_mtl.m: the game came back into focus or its window changed size since the last call (nvn_fstep.h settle)
 __attribute__((weak)) void dm_yield_top(char *out, size_t n) { if (n) snprintf(out, n, "-"); }   // hle_thread.c: the threads that yielded most since the last call; none in graphics unit tests
 __attribute__((weak)) void dm_thread_cpu(char *out, size_t n, double secs) { (void)secs; if (n) snprintf(out, n, "-"); }   // hle_thread.c: guest-thread CPU by Switch priority band since the last call
@@ -2468,6 +2469,7 @@ NVN(nvnQueuePresentTexture, void, NVNqueue *q, NVNwindow *w, int idx) {
     if (dm_fps_state) __atomic_store_n((uint32_t *)(dm_fps_state + 4), (uint32_t)dm_movie_playing(), __ATOMIC_RELAXED);   // the stubs' copy of the movie state (hle.h)
     int c = fps_step_cap();
     if (dm_fps_state) { static int was; if (c != was) { LOG("[nvn] frame step cap %d → %d fps at present %llu%s", was, c, (unsigned long long)o->presents, c == 30 && was == 60 ? (dm_movie_playing() ? " (movie playing)" : thermal_capped() ? " (thermal state serious)" : "") : ""); was = c; } }
+    mtl_low_lag_tick(g_fs_start, present_itv(o)); if (!c) g_fs_start = g_fs_wait = 0;   // NXForge: nxforge/low_lag.h (without a frame step nothing else takes the frame's start)
     if (c) fstep_tick(o, c);
     dm_fps_lock_tick();   // after the frame step: at 120 fps the target follows the hold just decided
     static uint64_t prev_in, prev_out, prev_pass, prev_draw;
diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 39cc3ce4cdcaff61f3049373323dba0827eef479..354dbbe2c3d83ad4380518d3e01460660dbcf482 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -145,6 +145,7 @@ static void ext_retire(NSArray *textures);
 int g_dm_present_link;   // Present pacing mode (runtime value of DM_PRESENT_LINK, modified directly during same-process alternating measurement): 0 = acquire the drawable itself; 1 = display link at 60 Hz; 2 = display link at 120 Hz, the game presents a frame every other display-link tick
 static int g_present_latency;   // DM_PRESENT_LATENCY: the display link's frame latency in a window and in fullscreen alike (0 = not set: link_latency picks it)
 static int g_present_link_env;   // DM_PRESENT_LINK was set: its mode holds everywhere, and link_vrr_120 does not move a 60 Hz link to 120 Hz in variable-refresh fullscreen
+static int nxf_ll_trim_drop(uint64_t wait_ns);   // NXForge: nxforge/low_lag.inc
 static uint64_t g_pq_done;
 static uint64_t g_pq_read;
 static id<MTLResidencySet> g_res;
@@ -17866,9 +17867,10 @@ static int present_now(const tex_t *t, double period, uint64_t frame, uint64_t t
     present_pipeline(layer.pixelFormat);   // Same as the original path: the first frame compiles the pipeline before taking the drawable
     if (g_grab_cb && g_fi_phase != FI_HELD) grab_present(src, crop, layer.drawableSize);   // Game picture needed by the whole-window screenshot (peek without the lock first; the real take locks inside the function)
     if (atomic_load(&g_recorder_on) && g_fi_phase != FI_HELD) record_present(src, crop);   // the video recorder's frame (capture_mac.m)
+    static uint64_t nxf_dr_wait; if (!supplied && nxf_ll_trim_drop(nxf_dr_wait)) { nxf_dr_wait = 0; return 0; }   // NXForge: nxforge/low_lag.h (the trim)
     uint64_t dt0 = now_ns();
     id<CAMetalDrawable> dr = supplied ? supplied : [layer nextDrawable];
-    if (!supplied) g_drawable_ns += now_ns() - dt0;
+    if (!supplied) g_drawable_ns += nxf_dr_wait = now_ns() - dt0;
     if (!dr) return 0;
     int alloc_i = (int)(ticket % 3);
     if (g_present_alloc_fence[alloc_i]) {
@@ -18097,6 +18099,7 @@ static void *link_main(void *arg) {   // Display link thread: started when switc
     g_link_started = 0;
     return NULL;
 }
+#include "nxforge/low_lag.inc"   // NXForge: direct presents in a window while the game has headroom
 static void link_sync(void) {   // Called every frame by the game's present thread: aligns the display link object's state to g_dm_present_link and the power-saving mode (can change at run time)
     static int applied;
     pthread_mutex_lock(&g_pq_mu);
@@ -18114,6 +18117,7 @@ static void link_sync(void) {   // Called every frame by the game's present thre
     // 60 fps game ran at 30 (lead 49.7 -> 16.5 ms); DM_PRESENT_LINK=0 held 60 (Mario vs. Donkey Kong, M4 Pro; latency 2 settled at about 42 there). Back to the link in a window.
     // NXForge keeps this over upstream's frame latency 2 in fullscreen (link_latency); DM_PRESENT_LATENCY keeps the link in fullscreen at that latency, to compare
     if (want && front_fullscreen() && !g_present_latency && !nxf_fi_wants_link()) want = 0;   // NXForge: frame interpolation keeps the link in fullscreen
+    if (want == 1 && nxf_low_lag_direct()) want = 0;   // NXForge: low_lag.h
     pthread_mutex_unlock(&g_pq_mu);
     if (want && mtl_fps_target() == 30 && link_30hz()) want = 3;   // Power-saving mode: display link at 30 Hz
     if (want) front_screen_match(want == 3 ? 30 : want == 2 ? 120 : 60);   // the game's rate: a variable-refresh screen goes to a fixed-rate mode at a multiple where it has one
diff --git a/dm/gfx/tests/Makefile b/dm/gfx/tests/Makefile
index 7c9ed4bd1a42770799e64246c50646f30b27ebbc..22a20d8d1fa51c1b668213953cce0a07eb70da58 100644
--- a/dm/gfx/tests/Makefile
+++ b/dm/gfx/tests/Makefile
@@ -88,6 +88,8 @@ t_counter_clock: t_counter_clock.m ../../host/hle_os.c ../../host/dm.h $(MTL_T_D
 	clang $(CFLAGS) -fobjc-arc -o $@ t_counter_clock.m ../../host/hle_os.c $(MTL_T_SRC) $(FW)
 t_fstep: t_fstep.c ../nvn/nvn_fstep.h
 	clang -O1 -Wall -o $@ t_fstep.c
+t_low_lag: t_low_lag.c ../nvn/nxforge/low_lag.h
+	clang -O1 -Wall -o $@ t_low_lag.c
 t_thermal: t_thermal.c $(MTL_T_DEP)
 	clang $(CFLAGS) -fobjc-arc -o $@ t_thermal.c $(MTL_T_SRC) ../nvn/nvn_mtl.m $(FW)
 t_thermal_tsan: t_thermal.c $(MTL_T_DEP)
