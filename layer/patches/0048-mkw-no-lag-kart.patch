+    pthread_mutex_unlock(&g_vp_mu); return r;
+}
+// Whether a guest range can be written through a sparse pool's page table: it lies in a sparse pool, or a sparse pool has mapped pages of the physical pool it lies in (v->phys).
+// An upload that copies the range on the CPU (nvn_mtl.m up_copy_src) must see GPU writes made through either
+int nvn_sparse_reaches(uint64_t lo, uint64_t hi) {
+    if (hi <= lo) return 0;
+    int r = 0; pthread_mutex_lock(&g_vp_mu);
+    for (int k = 0; k < g_nvp && !r; k++) { const struct vpool *v = g_vp[k]; uint64_t base = (uint64_t)(uintptr_t)v->base;
+        r = (lo < base + v->len && base < hi) || v->phys_all;
+        for (int i = 0; i < v->nphys && !r; i++) r = lo < v->phys[i].hi && v->phys[i].lo < hi; }
+    pthread_mutex_unlock(&g_vp_mu); return r;
+}
