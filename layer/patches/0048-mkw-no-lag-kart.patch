+    for (int i = 0; i < g_npool && ok; i++) { int v = g_pidx[i]; ok = v >= 0 && v < g_npool && !seen[v] && (!i || g_pools[g_pidx[i - 1]].lo <= g_pools[v].lo); if (ok) seen[v] = 1; }
+    free(seen);
