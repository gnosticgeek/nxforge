+GFX_H=$(sort $(wildcard ../gfx/nvn/*.h ../gfx/nvn/*.inc ../gfx/nvn/nxforge/*.inc ../gfx/nvn/include/*.h ../gfx/tex/*.h))   # *.inc: nvn_mtl.m includes them (nvn_geometry.inc); an edit there alone used not to rebuild the host
 # Third party: libvpx ships the VP8 and VP9 decoder sources (movie decoding, hle_movie.c), with its configuration headers in config/ (arm64, shared by Mac and iOS). Built separately into a static library, file by file, so host changes do not recompile it
 VPX=../third_party/libvpx
 VPX_SRC=$(sort $(shell find $(VPX) -name '*.c'))
@@ -34,6 +34,12 @@ gen/vpx/%.o: $(VPX)/%.c $(wildcard $(VPX)/config/*.h) ../mac/min_os.mk
 	clang -O2 -g -mmacosx-version-min=$(MACOS_MIN) -I$(VPX) -I$(VPX)/config -c $< -o $@
 $(VPX_LIB): $(VPX_OBJ)
 	rm -f $@; ar rcs $@ $^
+# Quick settings sidebar (quick_settings_mac.swift, SwiftUI): compiled on its own into an object the host's single compile line links, as libvpx is; the Swift runtime and SwiftUI come with macOS
+QS_OBJ=gen/quick_settings_mac.o
+$(QS_OBJ): quick_settings_mac.swift quick_settings_mac.h front.h ../mac/min_os.mk
+	@mkdir -p gen
+	swiftc -O -target arm64-apple-macos$(MACOS_MIN) -parse-as-library -module-name dmquick -import-objc-header quick_settings_mac.h -c quick_settings_mac.swift -o $@
+SWIFT_LD=-L$(shell xcrun --show-sdk-path)/usr/lib/swift -L$(dir $(shell xcrun -f swiftc))../lib/swift/macosx -Wl,-rpath,/usr/lib/swift
 # Third party: dav1d, the AV1 decoder where VideoToolbox has none (hle_movie_av1.c), with its arm64 NEON assembly and its configuration in config/. Its *_tmpl.c files are built
 # through the per-bit-depth wrappers in config/tmpl, and the assembly files other assembly files include (*_tmpl.S, util.S) are not built on their own: the list meson builds
 DAV1D=../third_party/dav1d
@@ -79,8 +85,8 @@ endif
