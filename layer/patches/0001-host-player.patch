+// Whether a save can live in dir: the host's save transaction clones the save folder (clonefile) and publishes a commit by swapping folders (renamex_np RENAME_SWAP), which
+// only APFS can do. On an exFAT, FAT or HFS+ drive the host mounts the save read-only and every save write fails; Mario Kart World then spins in its save manager and never
+// takes input. 1 when the volume says it can do both, or when it cannot be asked (as before)
+static int save_capable(const char *dir) {
+    struct statfs sf; if (statfs(dir, &sf)) return 1;
+    struct attrlist al = { .bitmapcount = ATTR_BIT_MAP_COUNT, .volattr = ATTR_VOL_INFO | ATTR_VOL_CAPABILITIES };
+    struct { uint32_t len; vol_capabilities_attr_t caps; } __attribute__((aligned(4), packed)) buf;
+    if (getattrlist(sf.f_mntonname, &al, &buf, sizeof buf, 0)) return 1;
+    const uint32_t need = VOL_CAP_INT_CLONE | VOL_CAP_INT_RENAME_SWAP;
+    return (buf.caps.capabilities[VOL_CAPABILITIES_INTERFACES] & buf.caps.valid[VOL_CAPABILITIES_INTERFACES] & need) == need;
+}
+// The ._<name> files macOS writes beside each file on an exFAT, FAT or SMB drive (its extended attributes) and Finder's .DS_Store are not the game's: a save copied
+// off such a drive leaves them behind
+static int skip_appledouble(int what, int stage, copyfile_state_t st, const char *src, const char *dst, void *ctx) {
+    (void)st; (void)dst; (void)ctx;
+    if (stage == COPYFILE_START && (what == COPYFILE_RECURSE_FILE || what == COPYFILE_RECURSE_DIR)) {
+        const char *b = strrchr(src, '/'); b = b ? b + 1 : src;
+        if (!strncmp(b, "._", 2) || !strcmp(b, ".DS_Store")) return COPYFILE_SKIP;
+    }
+    return COPYFILE_CONTINUE;
+}
+// The save in the game folder (to: <game folder>/Saves/save). The first time, the save in Application Support (from) is copied there: into a temporary folder beside it, then renamed
+// into place, so a copy cut short is never taken for the save. The old one is never moved or deleted. When both hold a save the game folder's wins and neither is touched.
+// Also used the other way, to bring a save from a game folder that cannot hold one (save_capable) back into Application Support.
+// 0: use from instead this time (the copy failed)
+static int save_move_in(const char *from, const char *to) {
+    if (has_data(to)) { if (has_data(from)) fprintf(stderr, "launcher: save %s (the older one in %s stays as it was)\n", to, from); return 1; }
+    if (!has_data(from)) { mkdirs(to); return 1; }
+    char tmp[PATH_MAX], dir[PATH_MAX]; snprintf(dir, sizeof dir, "%s", to); *strrchr(dir, '/') = 0; mkdirs(dir);
+    snprintf(tmp, sizeof tmp, "%s/.save-copy-%d", dir, (int)getpid());
+    copyfile_state_t cs = copyfile_state_alloc(); copyfile_state_set(cs, COPYFILE_STATE_STATUS_CB, (const void *)skip_appledouble);
+    int failed = copyfile(from, tmp, cs, COPYFILE_ALL | COPYFILE_RECURSIVE | COPYFILE_CLONE); copyfile_state_free(cs);
+    if (failed || (rmdir(to) && errno != ENOENT) || rename(tmp, to)) {
+        fprintf(stderr, "[RED] launcher: could not copy the save from %s to %s (%s): using it where it is this time\n", from, to, strerror(errno));
+        removefile(tmp, NULL, REMOVEFILE_RECURSIVE);   // only the half-made copy
+        return 0;
+    }
+    fprintf(stderr, "launcher: copied the save from %s to %s; the old one stays where it was\n", from, to);
+    return 1;
+}
