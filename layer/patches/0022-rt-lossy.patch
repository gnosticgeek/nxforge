From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EmmanueleC <ai.emmanuelecrifasi@gmail.com>
Date: Wed, 11 Nov 2026 08:25:43 +0100
Subject: rt-lossy: lossy compression for standalone render targets
 (DM_NVN_RT_LOSSY=1, off by default)

Ported from Fasen24-AI/swordboiMacNative af07b1df (EmmanueleC, MIT), also taken by brad-n/TVPort 322b545b.
A private render target with no shader writes, atomics or format views, in one of eight formats measured on
Apple8+ GPUs, is made with MTLTextureCompressionTypeLossy when it gets an allocation of its own (after the pool
and family paths). Less GPU memory and bandwidth for some loss of exactness; off until an image-quality A/B.
Check: make -C dm/gfx/tests GAME=<id> check_t_rt_lossy (Mac).
---
 dm/gfx/nvn/nvn_mtl.m      | 20 ++++++++-
 dm/gfx/tests/Makefile     |  7 +++
 dm/gfx/tests/t_rt_lossy.m | 89 +++++++++++++++++++++++++++++++++++++++
 docs/env_switches.tsv     |  1 +
 4 files changed, 116 insertions(+), 1 deletion(-)
 create mode 100644 dm/gfx/tests/t_rt_lossy.m

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index c65a8f3a654c2214b50acdb488664525e09c956e..33a4c1c8d5b2b45af1e70bbf2a1a48e712bffb7d 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -4304,6 +4304,24 @@ static inline void tex_lsize(const tex_t *t, unsigned l, uint32_t *w, uint32_t *
     *w = l < 32 ? MAX(t->d.width >> l, 1u) : 1u; *h = l < 32 ? MAX(H >> l, 1u) : 1u;
     if (z) *z = l < 32 ? MAX(Z >> l, 1u) : 1u;
 }
+// NXForge (Fasen24-AI/swordboiMacNative af07b1df, EmmanueleC, MIT): lossy compression for standalone render targets, DM_NVN_RT_LOSSY=1 (off by default).
+// Metal asserts on unsupported lossy formats rather than returning nil. Keep the
+// whitelist to formats measured on Apple8+ hardware, and apply it only after the
+// family/pool paths: their shared bytes may require uncompressed storage.
+static void rt_lossy_apply(MTLTextureDescriptor *d) {
+    static int on; static dispatch_once_t once;
+    dispatch_once(&once, ^{ const char *e = getenv("DM_NVN_RT_LOSSY"); on = e && atoi(e) > 0; });
+    if (!on || ![g_dev supportsFamily:MTLGPUFamilyApple8] || d.storageMode != MTLStorageModePrivate || !d.allowGPUOptimizedContents
+        || !(d.usage & MTLTextureUsageRenderTarget) || (d.usage & (MTLTextureUsageShaderWrite | MTLTextureUsageShaderAtomic | MTLTextureUsagePixelFormatView))
+        || d.textureType == MTLTextureType1D || d.textureType == MTLTextureType1DArray || d.textureType == MTLTextureTypeTextureBuffer) return;
+    switch (d.pixelFormat) {
+        case MTLPixelFormatR8Unorm: case MTLPixelFormatR32Float: case MTLPixelFormatRG16Float:
+        case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatRGBA8Unorm_sRGB: case MTLPixelFormatBGRA8Unorm:
+        case MTLPixelFormatRGB10A2Unorm: case MTLPixelFormatRGBA16Float:
+            d.compressionType = MTLTextureCompressionTypeLossy; break;
+        default: break;
+    }
+}
 // In-place upgrade: when the original texture was not created with PixelFormatView (off by default, to keep Apple GPU lossless compression) but a different-format view is needed, create a new one with the original spec + PixelFormatView, copy over every slice × level, and replace the registration.
 // Count: across the 4 screens character select / camp / wilderness / combat, 17473 textures needed a different-format view 0 times, so this is a fallback and does not rely on predicting which textures need it
 // The same upgrade adds render-target usage for a whole-level clear (clear_tex) of a texture made without it: Monster Hunter Rise clears a 32x80 packaged one
@@ -7268,7 +7286,7 @@ static void *tex_mtl_resolve(const tex_t *ct, int *in_storage, id<MTLTexture> __
         mt = pair_texture(t, d);   // (neither filled: their storage is shared)
         if (!mt) mt = image_texture(t, d);
         if (!mt) mt = pool_heap_texture(t, d);
-        if (!mt) { mt = rh_texture(t, d); if (!mt) mt = [g_dev newTextureWithDescriptor:d];
+        if (!mt) { rt_lossy_apply(d); mt = rh_texture(t, d); if (!mt) mt = [g_dev newTextureWithDescriptor:d];   // NXForge: rt_lossy_apply, DM_NVN_RT_LOSSY
             if (mt) { res_add(mt); if (!bcp_up_fill(t, mt) && !tex_init_fill(t, mt)) tex_zero_fill(mt); } }   // a side of a compressed-alias pair takes the other side's bytes (bcp_up_fill)
         if (!mt) { RED_ONCE(2, "failed to create MTLTexture %ux%u format %#x target %d", t->d.width, t->d.height, t->d.format, t->d.target); return NULL; }
     }
diff --git a/dm/gfx/tests/Makefile b/dm/gfx/tests/Makefile
index dba7553b93c93a5ce21b8db82d7c1f78808c7b32..71e5ba1b674877cfe6c2cbcaf81b58635c6b3399 100644
--- a/dm/gfx/tests/Makefile
+++ b/dm/gfx/tests/Makefile
@@ -1112,3 +1112,10 @@ t_cpuprof: t_cpuprof.m $(MTL_T_DEP)
 check_t_cpuprof: t_cpuprof
 	MTL_DEBUG_LAYER=1 DM_NVN_CPUPROF=1 DM_NVN_ENC_THREAD=0 ./t_cpuprof
 	MTL_DEBUG_LAYER=1 DM_NVN_CPUPROF=1 DM_NVN_ENC_THREAD=1 ./t_cpuprof
+
+t_rt_lossy: t_rt_lossy.m $(MTL_T_DEP)
+	clang $(CFLAGS) -fobjc-arc -o $@ t_rt_lossy.m $(MTL_T_SRC) $(FW)
+.PHONY: check_t_rt_lossy
+check_t_rt_lossy: t_rt_lossy
+	MTL_DEBUG_LAYER=1 ./t_rt_lossy
+	MTL_DEBUG_LAYER=1 ./t_rt_lossy off
diff --git a/dm/gfx/tests/t_rt_lossy.m b/dm/gfx/tests/t_rt_lossy.m
new file mode 100644
index 0000000000000000000000000000000000000000..7cf2f26fd2b3b8bbf7c0e4b181a66429d30a47d7
--- /dev/null
+++ b/dm/gfx/tests/t_rt_lossy.m
@@ -0,0 +1,89 @@
+// Unsupported lossy descriptors abort in Metal instead of returning nil: eligibility
+// must be decided before allocation, and the default path must remain lossless.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+
+static tex_t target(pool_t *p, unsigned format, unsigned flags, uint64_t serial) {
+    tex_t t = {.magic = MAGIC('T','E','X',0), .pool = p, .serial = serial, .off = (int64_t)(serial % 128) * (2 << 20)};
+    t.mem = p->mem + t.off;
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = format, .flags = flags,
+        .width = 512, .height = 512, .depth = 1, .levels = 1, .samples = 1};
+    nvn_tex_layout(&t.d, &t.L); mtl_tex_init(&t); return t;
+}
+int main(int argc, char **argv) { @autoreleasepool {
+    int on = argc == 1;
+    if (on) setenv("DM_NVN_RT_LOSSY", "1", 1); else unsetenv("DM_NVN_RT_LOSSY");
+    setenv("DM_NVN_POOL_HEAP", "0", 1); setenv("DM_NVN_RT_RECYCLE", "0", 1);
+    mtl_init();
+    if (![g_dev supportsFamily:MTLGPUFamilyApple8]) { puts("SKIP: lossy compression needs Apple8"); return 0; }
+    MTLTextureDescriptor *valid = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:512 height:512 mipmapped:NO];
+    valid.storageMode = MTLStorageModePrivate; valid.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    rt_lossy_apply(valid);
+    id<MTLTexture> bgra = [g_dev newTextureWithDescriptor:valid];
+    CHECK(bgra && bgra.compressionType == (on ? MTLTextureCompressionTypeLossy : MTLTextureCompressionTypeLossless), "the measured BGRA8 format is supported");
+    for (int k = 0; k < 11; k++) {
+        MTLTextureDescriptor *d = [valid copy]; d.compressionType = MTLTextureCompressionTypeLossless;
+        switch (k) {
+            case 0: d.storageMode = MTLStorageModeShared; break;
+            case 1: d.allowGPUOptimizedContents = NO; break;
+            case 2: d.usage |= MTLTextureUsageShaderWrite; break;
+            case 3: d.usage |= MTLTextureUsageShaderAtomic; break;
+            case 4: d.usage |= MTLTextureUsagePixelFormatView; break;
+            case 5: d.usage = MTLTextureUsageShaderRead; break;
+            case 6: d.textureType = MTLTextureType1D; break;
+            case 7: d.textureType = MTLTextureType1DArray; break;
+            case 8: d.textureType = MTLTextureTypeTextureBuffer; break;
+            case 9: d.pixelFormat = MTLPixelFormatBC1_RGBA; break;
+            case 10: d.pixelFormat = MTLPixelFormatASTC_4x4_LDR; break;
+        }
+        rt_lossy_apply(d);
+        CHECK(d.compressionType == MTLTextureCompressionTypeLossless, "unsupported usage, storage, type and formats never select lossy");
+    }
+    pool_t p = {.magic = MAGIC('P','O','O','L'), .flags = NVN_MEMORY_POOL_FLAGS_CPU_NO_ACCESS | NVN_MEMORY_POOL_FLAGS_VIRTUAL,
+        .size = 256 << 20, .vmode = 1};
+    p.mem = aligned_alloc(16384, p.size);
+    unsigned formats[] = {NVN_FORMAT_R8, NVN_FORMAT_R32F, NVN_FORMAT_RG16F,
+        NVN_FORMAT_RGBA8, NVN_FORMAT_RGBA8_SRGB, NVN_FORMAT_RGB10A2, NVN_FORMAT_RGBA16F};
+    mtl_sub_begin();
+    for (unsigned i = 0; i < sizeof formats / sizeof *formats; i++) {
+        tex_t t = target(&p, formats[i], NVN_TEXTURE_FLAGS_COMPRESSIBLE, 999000 + i);
+        id<MTLTexture> mt = tex_mtl(&t);
+        CHECK(mt != nil, "an allowed target is allocated");
+        CHECK(mt.compressionType == (on ? MTLTextureCompressionTypeLossy : MTLTextureCompressionTypeLossless), "the actual render-target path honors the opt-in");
+        MTLTextureDescriptor *d = tex_desc(&t, 0); MTLSizeAndAlign full = [g_dev heapTextureSizeAndAlignWithDescriptor:d];
+        if (on) CHECK(mt.allocatedSize < full.size * 3 / 4, "lossy storage is materially smaller than lossless");
+        if (formats[i] == NVN_FORMAT_RGBA8) {
+            id<MTLTexture> srgb = [mt newTextureViewWithPixelFormat:MTLPixelFormatRGBA8Unorm_sRGB];
+            CHECK(srgb != nil, "an sRGB twin can still read the target");
+            id<MTLTexture> upgraded = tex_upgrade(&t, mt, MTLTextureUsageShaderWrite, MTLPixelFormatInvalid);
+            CHECK(upgraded && (upgraded.usage & MTLTextureUsageShaderWrite), "a later shader write upgrades the target");
+            CHECK(upgraded.compressionType == MTLTextureCompressionTypeLossless, "a shader-writable upgrade is lossless");
+        }
+    }
+    unsigned excluded[] = {NVN_FORMAT_R11G11B10F, NVN_FORMAT_DEPTH32F};
+    for (unsigned i = 0; i < sizeof excluded / sizeof *excluded; i++) {
+        tex_t t = target(&p, excluded[i], NVN_TEXTURE_FLAGS_COMPRESSIBLE, 999020 + i);
+        id<MTLTexture> mt = tex_mtl(&t);
+        CHECK(mt && mt.compressionType == MTLTextureCompressionTypeLossless, "depth and packed float stay lossless without asserting");
+    }
+    tex_t image = target(&p, NVN_FORMAT_RGBA16F, NVN_TEXTURE_FLAGS_COMPRESSIBLE | NVN_TEXTURE_FLAGS_IMAGE, 999030);
+    id<MTLTexture> im = tex_mtl(&image);
+    CHECK(im && im.compressionType == MTLTextureCompressionTypeLossless, "shader-writable images stay lossless");
+    tex_t a = target(&p, NVN_FORMAT_RGBA16F, NVN_TEXTURE_FLAGS_COMPRESSIBLE, 999040), b = a;
+    b.serial = 999041; b.d.width = b.d.height = 256; nvn_tex_layout(&b.d, &b.L); mtl_tex_init(&b);
+    id<MTLTexture> ma = tex_mtl(&a), mb = tex_mtl(&b);
+    CHECK(ma.heap && ma.heap == mb.heap, "resolution-family sharing remains available");
+    CHECK(ma.compressionType == MTLTextureCompressionTypeLossless,   // families keep Metal's lossless compression since upstream 4015ce2c; the lossy opt-in never reaches them
+          "family storage is never forced into lossy compression");
+    mtl_sub_commit(); mtl_drain();
+    CHECK(!mtl_last_commit_error(), "initialization and the upgrade copy finish without GPU errors");
+    mtl_alias_drop_pool(&p); mtl_drain();
+    printf("%d checks, %d failures\n", checks, failed); return failed != 0;
+} }
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index 7414c810ade3218d97d18a6c15b183a44ddae5b1..6fafe1e2a8cdbd0c4231ee04cd54cc402a5ac97a 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -263,6 +263,7 @@ DM_NVN_ROP_ROUND	switch	`0` leaves float colours going into 8-bit, 16-bit and RG
 DM_NVN_RP_AREA	switch	`0` makes passes on targets of 16 M pixels or more cover the whole target, as before; by default a draw pass that loads what it keeps stops at the far corner of its scissor when that is at most half the target
 DM_NVN_RT_CONTINUE	switch	`0` ends the pass whenever the game sets render targets, as before; by default SetRenderTargets naming the open pass's targets continues the pass
 DM_NVN_RT_DEAD	switch	`0` keeps every shared render target of a GPU-only pool while a texture object names it, as before; by default one another target drew over and that has not been used for 3 s is released once a second, and made again at its next use (`ab` alternates it with the `DM_AB` phases)
+DM_NVN_RT_LOSSY	switch	`1` enables lossy compression for standalone private render targets of an explicit Apple8+ format whitelist, without shader writes, atomics or pixel-format-view usage; family/pool heaps keep their existing layout (off by default)
 DM_NVN_RT_RECYCLE	switch	`0` makes each render target in a GPU-only pool, each feedback snapshot and each resolution family heap its own exact Metal allocation, freed with its texture, as before; by default they are placed in heaps from one free list, and a freed one's heap waits, resident, for the next texture it fits (`ab` alternates it with the `DM_AB` phases)
 DM_NVN_RUNTIME_COMPILER	path	Mac development runs: `dmsh_live.py` from the same checkout as the host. Compiles missing NVN1 vertex and pixel stages with the packer's toolchain and caches them under `DM_TEMP/nvn-shaders`.
 DM_NVN_RUNTIME_PYTHON	path	Mac development runs: the Python executable that runs `DM_NVN_RUNTIME_COMPILER`.
