From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 17:43:17 +0000
Subject: fstep-settle: The host names a pause or a window change for the frame
 step, and keeps the GPU powered through a pause

mtl_fstep_settle reports a return to focus or a drawable size change; nvn_fstep
takes that frame as a stall and does not pay its lateness back. DM_NVN_PAUSE_WARM
(Mac): a 64-byte fill twice a second while nothing is presented, up to 2 minutes.
---
 dm/gfx/nvn/hle_nvn.c         |  2 ++
 dm/gfx/nvn/nvn_fstep.h       | 11 ++++++---
 dm/gfx/nvn/nvn_mtl.m         | 45 ++++++++++++++++++++++++++++++++++++
 dm/gfx/tests/t_fstep.c       | 13 +++++++++++
 docs/agents/symptoms.md      |  1 +
 docs/env_switches.tsv        | 28 +++++++++++++++++++++-
 docs/reference/frame-rate.md | 11 +++++++--
 7 files changed, 105 insertions(+), 6 deletions(-)

diff --git a/dm/gfx/nvn/hle_nvn.c b/dm/gfx/nvn/hle_nvn.c
index c0c888af8b343fef5d942ea934c523e88c1aabae..dc59b39b4dede6d5b95e5f48288caca3c0611e37 100644
--- a/dm/gfx/nvn/hle_nvn.c
+++ b/dm/gfx/nvn/hle_nvn.c
@@ -1874,6 +1874,7 @@ static int link_wait(const win_t *o, uint64_t timeout_ns);
 __attribute__((weak)) void dm_main_yield_stats(uint64_t *n, uint64_t *ns) { *n = 0; *ns = 0; }   // The host's hle_thread.c provides the ground truth; 0 in graphics unit tests
 __attribute__((weak)) uint32_t dm_guest_work_qos(unsigned *count) { if (count) *count = 0; return QOS_CLASS_UNSPECIFIED; }
 int mtl_probe_ramp_on(void);   // nvn_mtl.m: DM_FSTEP_PROBE_RAMP (default on; ab with DM_AB)
+int mtl_fstep_settle(void);    // nvn_mtl.m: the game came back into focus or its window changed size since the last call (nvn_fstep.h settle)
 __attribute__((weak)) void dm_yield_top(char *out, size_t n) { if (n) snprintf(out, n, "-"); }   // hle_thread.c: the threads that yielded most since the last call; none in graphics unit tests
 __attribute__((weak)) void dm_thread_cpu(char *out, size_t n, double secs) { (void)secs; if (n) snprintf(out, n, "-"); }   // hle_thread.c: guest-thread CPU by Switch priority band since the last call
 void mtl_res_stats(char *out, size_t n);
@@ -2537,6 +2538,7 @@ static void fstep_tick(const win_t *o, int c) {
     // A probe's grace lasts while its frames keep getting cheaper (nvn_fstep.h FSTEP_RAMP): macOS raises the GPU clock for the shorter deadline over seconds, not the iPhone's 30 frames
     // (Breath of the Wild on an M5 Pro: the probe's 33 frames took the clock 338 → 432 MHz and its GPU time 24.8 → 18.5 ms, then it failed at 22 ms frames; hold 1 needed about 560 MHz)
     g_fs.ramp = mtl_probe_ramp_on();
+    g_fs.settle = mtl_fstep_settle();   // a pause ended or the window changed: this frame and the grace after it are not what the scene costs
     g_fs.per_vsync = fstep_hz() / 60;
     g_fs.smax = dm_fps_step_max;   // the stub's largest step (Mario Kart World: 2): frames held longer than the game steps would play in slow motion
     g_fs.no_payback = fps_high();   // at 120 fps the game steps by its target, not by the step: a late frame is slow motion, so three raise the hold whatever the average
diff --git a/dm/gfx/nvn/nvn_fstep.h b/dm/gfx/nvn/nvn_fstep.h
index b5df3823afe7fb991514c13affade5f83945f3c5..f66404ac44cbf75fc9cc8abbb8dc9c6d8f446456 100644
--- a/dm/gfx/nvn/nvn_fstep.h
+++ b/dm/gfx/nvn/nvn_fstep.h
@@ -50,7 +50,10 @@
 // a silent display link. What it took is not what the scene costs, and the frames after it run late for the host's reasons: the GPU clock fell while nothing was drawn (Ocarina
 // of Time on an M4 Pro: the first frame after a pause of 1.2–35 s took 26–67 ms of GPU time where the scene takes 15) and the display link is finding its ticks again. Counted,
 // they stepped the hold up to 3 after every pause and fullscreen switch, 20 then 30 fps for about a second in a scene that held 60 before and after. So a stall is not late, and
-// the FSTEP_GRACE frames after it do not count toward a step up, as after a probe (a stall in that grace starts it again)
+// the FSTEP_GRACE frames after it do not count toward a step up, as after a probe (a stall in that grace starts it again).
+// The caller can say so itself (nvn_fstep.settle: the game came back into focus, its window changed size or went fullscreen), which also covers the frames of a window's
+// animation, late by a fraction of a vsync before any of them is a stall. The time the game was behind in such a frame is not paid back either: a pause is not time the game
+// owes, and paid back it played the first quarter second after every pause at double speed
 #define FSTEP_STALL 8.0       // vsyncs a frame was shown for that make it a stall (133 ms): more than twice the longest hold, so no step up would have made the frame fit
 
 typedef struct {
@@ -65,6 +68,7 @@ typedef struct {
     double hold, since;       // vsyncs a trial waits for after a step up; vsyncs since the last step up
     int per_vsync;            // set by the caller: the ticks a 1/60 s vsync is (0 = 1). At 120 fps the unit is 1/120 s (hle_nvn.c fps_high), and the waits between trials stay the same real time
     double shown_slack;       // vsyncs a frame on time may show longer than k (set by the caller): one refresh on screens whose rate is not a multiple of 60; the cost keeps FSTEP_LATE
+    int settle;               // set by the caller before a call, then cleared: this frame spans a pause or a window change (a stall whatever it took; its lateness is not debt)
     int screen;               // set by the caller before each call, then cleared: 0 = judge lateness by shown and cost; 1 = the screen showed a recent frame on time, 2 = late. With present
                               // snapshots (nvn_mtl.m) the game runs ahead of the screen and a frame that runs long is absorbed, so only what the screen shows counts
     double run, crun, cref;   // vsyncs at kmin in a row; the cost of its frames on time (running mean; not during a probe's trial, whose frames run while the clock rises);
@@ -119,7 +123,8 @@ static inline int nvn_fstep_next(nvn_fstep *s, double shown, double cost, int km
     double over = shown - held; if (over < -1) over = -1; if (over > FSTEP_SHORT_MAX) over = FSTEP_SHORT_MAX;
     s->over_sum += over - s->over[s->over_i]; s->over[s->over_i] = over; s->over_i = (s->over_i + 1) % FSTEP_RUN;
     s->last_cost[0] = s->last_cost[1]; s->last_cost[1] = s->last_cost[2]; s->last_cost[2] = cost;
-    s->debt += shown - s->step;
+    int settle = s->settle; s->settle = 0;
+    if (settle && shown > s->step) s->dropped += shown - s->step; else s->debt += shown - s->step;   // a pause is not time the game owes
     if (s->debt > FSTEP_DEBT_MAX) { s->dropped += s->debt - FSTEP_DEBT_MAX; s->debt = FSTEP_DEBT_MAX; }
     if (s->debt < -1) s->debt = -1;   // ahead (a frame shorter than its step): nothing slows the game down, so at most one vsync is remembered
     s->since += shown;
@@ -136,7 +141,7 @@ static inline int nvn_fstep_next(nvn_fstep *s, double shown, double cost, int km
         s->plate += late; s->ptotal++;
         if (!--s->grace && s->ramp && s->plate && s->ptotal + FSTEP_GRACE <= FSTEP_PROBE_MAX && s->pb <= (1 - FSTEP_RAMP) * s->pa) { s->grace = FSTEP_GRACE; s->pa = s->pb = 0; s->plate = 0; }   // still getting cheaper: another window
     }
-    int stall = shown >= FSTEP_STALL * (s->per_vsync ? s->per_vsync : 1), sgrace = stall || s->sgrace > 0;   // a stall, or a frame in the grace after one
+    int stall = settle || shown >= FSTEP_STALL * (s->per_vsync ? s->per_vsync : 1), sgrace = stall || s->sgrace > 0;   // a stall, or a frame in the grace after one
     if (stall) { s->sgrace = FSTEP_GRACE; s->stalls++; } else if (s->sgrace) s->sgrace--;
     if (late) { s->late++; s->late_run = grace || sgrace ? 0 : s->late_run + 1; s->fit_run = 0; } else s->late_run = 0;
     // The cost of the frames on time (a hitch is not what the scene costs): at kmin, and at the longer hold
diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index 95392dc774cda8e88c41a23ccdd25573311845d6..419de2dcdd2ce5244540fcf0ece7b747af56822a 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -16717,6 +16717,50 @@ static void sub_cut_begin(void) { g_cut_draw0 = g_stat_draw; }
 // DM_FSTEP_PROBE_RAMP=1 (default) / 0 / ab: a frame-step probe's grace is renewed while its frames keep getting cheaper (nvn_fstep.h FSTEP_RAMP), the time macOS's GPU clock takes to rise for the shorter deadline
 static int probe_ramp_mode(void) { static int m = -1; if (m < 0) m = sw_mode("DM_FSTEP_PROBE_RAMP", 1); return m; }
 int mtl_probe_ramp_on(void) { return sw_on(probe_ramp_mode()); }
+// A pause or a window change, for the frame step (nvn_fstep.h settle, asked once a frame by hle_nvn.c fstep_tick): the game came back into focus since the last call (the
+// front end's dm_focus_set(1): its window became key again, a pause ended), or the layer's drawable changed size (the window resized, entered or left fullscreen). The frames
+// around either are late for the host's reasons, not the scene's (frame-rate.md, "A pause or a window switch steps the hold up")
+int dm_focus_now(void); uint64_t dm_focus_in_since(void);
+static _Atomic uint64_t g_settle_px, g_settle_focus, g_warm_present_ns; static _Atomic int g_settle;
+static void pause_warm_start(void);
+static void settle_present(CGSize px) {   // each present, with the layer's drawable size
+    uint64_t v = (uint64_t)px.width | (uint64_t)px.height << 32;
+    if (atomic_exchange(&g_settle_px, v) != v) atomic_store(&g_settle, 1);
+    atomic_store(&g_warm_present_ns, now_ns());
+    pause_warm_start();
+}
+int mtl_fstep_settle(void) {
+    uint64_t f = dm_focus_in_since();
+    if (atomic_exchange(&g_settle_focus, f) != f) atomic_store(&g_settle, 1);
+    return atomic_exchange(&g_settle, 0);
+}
+// DM_NVN_PAUSE_WARM (Mac; 1 = on, 0 = off): while the game presents nothing (a pause: its window out of focus, a sidebar or menu over it), a few bytes of GPU work twice a
+// second keep the GPU powered. Left alone for about 2 s it powers down, and the first frame back pays for its return on the submit thread: Ocarina of Time on an M4 Pro, after
+// pauses of 2.5, 5.8 and 35 s, 126–178 ms inside the first residency set commit (off the CPU; 0.3 ms otherwise) and 26–67 ms of GPU time for a 15 ms frame; pauses of 1.2–1.9 s
+// had neither. It stops 2 minutes into a pause, so a game left paused lets the GPU sleep, and does nothing while frames are presented
+#define PAUSE_WARM_DEFAULT 1
+static void pause_warm_start(void) {
+#if TARGET_OS_OSX
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        const char *e = getenv("DM_NVN_PAUSE_WARM"); if (!(e ? atoi(e) : PAUSE_WARM_DEFAULT) || !g_q || !g_dev) return;
+        static dispatch_source_t t; static id<MTLBuffer> buf; static uint64_t n;
+        buf = [g_dev newBufferWithLength:64 options:MTLResourceStorageModePrivate];
+        t = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+        dispatch_source_set_timer(t, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 2), NSEC_PER_SEC / 2, NSEC_PER_SEC / 20);
+        dispatch_source_set_event_handler(t, ^{
+            uint64_t last = atomic_load(&g_warm_present_ns), now = now_ns();
+            if (!last || now - last < 400000000ull || now - last > 120000000000ull || atomic_load(&g_gpu_lost)) return;
+            @autoreleasepool {
+                id<MTLCommandBuffer> cb = [g_q commandBuffer]; id<MTLBlitCommandEncoder> b = [cb blitCommandEncoder];
+                [b fillBuffer:buf range:NSMakeRange(0, 64) value:0]; [b endEncoding]; [cb commit];
+            }
+            if (!n++) MLOG("pause warm: no frame presented for %.1f s, the GPU is kept powered with a 64-byte fill twice a second for up to 2 minutes (DM_NVN_PAUSE_WARM=0 turns it off)", (now - last) / 1e9);
+        });
+        dispatch_resume(t);
+    });
+#endif
+}
 static void sub_cut(void) {
     int n = cut_draws();
     if (!g_cb || g_enc) return;
@@ -18200,6 +18244,7 @@ static int present_now(const tex_t *t, double period, uint64_t frame, uint64_t t
     if (atomic_load(&g_gpu_lost)) return 0;   // the display command buffer would be ignored too: take no drawable from the screen the front end is about to close
     CAMetalLayer *layer = (__bridge CAMetalLayer *)front_metal_layer();
     if (!layer) return 0;
+    settle_present(layer.drawableSize);
     if (g_present_layer_resident != layer) { [g_q4 addResidencySet:layer.residencySet]; g_present_layer_resident = layer; }
 #if TARGET_OS_OSX
     if (!layer.displaySyncEnabled) layer.displaySyncEnabled = YES;   // Windowed mode follows the display's vsync to prevent tearing
diff --git a/dm/gfx/tests/t_fstep.c b/dm/gfx/tests/t_fstep.c
index 0de1bfdcb285d25b7d7a60cb60a2f9f1ffec3284..7b3f35ad62635cc33a3b35aa10234b263aab9130 100644
--- a/dm/gfx/tests/t_fstep.c
+++ b/dm/gfx/tests/t_fstep.c
@@ -470,6 +470,19 @@ int main(void) {
         check(f.s.k == 2 && f.s.stalls == 0, "  120 fps: 83 ms frames are not stalls");
         sim g = {0}; g.s.per_vsync = 2; run(&g, 240, 0.7, 1, 2, 0); run(&g, 1, 200, 1, 2, 0); run(&g, 3, 1.5, 1, 2, 0); run(&g, 60, 0.7, 1, 2, 0);
         check(g.s.k == 1 && g.s.stalls == 1, "  120 fps: a pause and three late frames keep 120");
+        // the caller names the pause (settle): nothing of it is paid back, where a stall it does not name (a load) still pays back FSTEP_DEBT_MAX
+        sim p = {0}; run(&p, 600, 0.9, 1, 3, 0); uint64_t paid0 = p.s.paid;
+        p.s.settle = 1; run(&p, 1, 114, 1, 3, 0); run(&p, 60, 0.9, 1, 3, 0);
+        snprintf(b, sizeof b, "  a pause the caller names is not paid back (paid %llu, debt %.2f)", (unsigned long long)(p.s.paid - paid0), p.s.debt);
+        check(p.s.paid == paid0 && p.s.debt < 1 && p.s.k == 1 && p.s.settle == 0, b);
+        sim q = {0}; run(&q, 600, 0.9, 1, 3, 0); paid0 = q.s.paid; run(&q, 1, 114, 1, 3, 0); run(&q, 60, 0.9, 1, 3, 0);
+        check(q.s.paid - paid0 == 15, "  a stall it does not name pays back 15 vsyncs as before");
+        // a fullscreen switch the caller names: frames late by a third of a vsync while the window animates, none of them a stall
+        sim w = {0}; run(&w, 600, 0.9, 1, 3, 0);
+        w.s.settle = 1; run(&w, 20, 1.34, 1, 3, 0); w.s.settle = 1; run(&w, 20, 1.34, 1, 3, 0); run(&w, 120, 0.9, 1, 3, 0);
+        check(w.s.k == 1 && w.s.ups == 0, "  a window change the caller names: 40 mildly late frames keep hold 1");
+        sim x = {0}; run(&x, 600, 0.9, 1, 3, 0); run(&x, 20, 1.34, 1, 3, 0);
+        check(x.s.k == 2 && x.s.ups == 1, "  the same frames with no window change step up as before");
     }
     printf("== %d checks, %d failed ==\n", checks, fail);
     return fail != 0;
diff --git a/docs/agents/symptoms.md b/docs/agents/symptoms.md
index 2fdc9314b9689ef048c17e973f06aac20421f163..46bb35ec4c4deea9a65ba6996c1ae97857c8e6a5 100644
--- a/docs/agents/symptoms.md
+++ b/docs/agents/symptoms.md
@@ -547,6 +547,7 @@ One line per symptom in the [subsystem references](../reference/): what you see
 - on a Mac, a GPU-bound game at 60 fps falls to 30 or 20 fps when the scene gets heavier and stays there until a menu or a lighter scene, while the GPU clock sits at its floor (338–400 MHz on an M5 Pro) and the GPU is powered 60–75% of the time; the log shows probes back to hold 1 that fail after about 33 frames (`frame step: hold 2 → 1 vsyncs … (probe, GPU 1.67× its time at hold 1)` then `the probe failed`), and the host's profiler (`@gpu_mhz`) shows the clock rising during each probe and falling back after it. → [A probe's grace lasts while its frames keep getting cheaper](../reference/frame-rate.md#a-probes-grace-lasts-while-its-frames-keep-getting-cheaper)
 - on a Mac, 20 or 30 fps for 10–40 s after a new area loads, then a steady 60 again, with nothing compiling or uploading in between; the log shows `frame step: hold 1 → 2` and `hold 2 → 3 vsyncs … (3 late frames` within a few presents of each other at the load, long-frame lines of exactly 50 ms with `GPU` 22–44 ms and no new pipelines or uploads, and much later `hold 3 → 1 vsyncs … (probe, GPU 6.24× its time at hold 1` followed by `the probe held`. → [Single frames over the fit keep a longer hold](../reference/frame-rate.md#single-frames-over-the-fit-keep-a-longer-hold)
 - after every pause (the game out of focus, then back), fullscreen switch or covered window, a game that held 60 fps plays at 20 and then 30 fps for about a second; the log shows `frame step: hold 1 → 3 vsyncs at present … (3 late frames; cost 3.00, GPU 0.89; …)` right after `oe focus state → 1` or `front end: window visible`, then a trial to 2 and a probe back to 1 that holds. → [A pause or a window switch steps the hold up](../reference/frame-rate.md#a-pause-or-a-window-switch-steps-the-hold-up)
+- after a pause of about 2 s or more, one frame of 130–300 ms, then the game runs as before; the long-frame line shows the time inside the residency set commit with the submit thread off the CPU (`submit 152.9 ms wall / 9.6 CPU …, off CPU 143.3; residency commits 143.4 ms`) and a first GPU time well above the scene's (26–67 ms for 15). Pauses of 1.2–1.9 s show neither. → [The first frame after a pause waits for the GPU](../reference/frame-rate.md#the-first-frame-after-a-pause-waits-for-the-gpu)
 - a game whose profile has a frame step (`FRAME_STEP` in its `patches.py`) runs at double speed when packed from another update; the log has no `frame step in whole vsyncs` line, and the frame counter shows 60. → [A derived profile drops the frame step its build lacks](../reference/frame-rate.md#a-derived-profile-drops-the-frame-step-its-build-lacks)
 - a fixed-step game runs at double speed (or slow motion at 30) after `DM_FPS_TARGET` is set, in `Documents/env.txt` or the launcher, on a build its profile's frame step stubs and limiter rows do not know. → [A present cap applies only with a frame step or an engine limit the host writes](../reference/frame-rate.md#a-present-cap-applies-only-with-a-frame-step-or-an-engine-limit-the-host-writes)
 - a game holds 30 fps with spare CPU and GPU time; it asks for present interval 2 once (`the game sets present interval 1 → 2`) and nothing else limits it. With `present_interval display` it runs at 60, but `fps_target` logs `present cap … not applied` and the player's **Frame rate** (30 or 60) does nothing: frames stay at one a display tick. → [A present interval that is the game's only limit, in display mode](../reference/frame-rate.md#a-present-interval-that-is-the-games-only-limit-in-display-mode)
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index 7bcb8328ad54b8e0ef40fd1e7a81ce5bd78a54e4..87b996375e2dc8cff43856e3548890873196eb86 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -3,6 +3,7 @@ DM_AB	diagnostic	`=<frames>` splits the run into phases of that many frames and
 DM_ALIAS_SIZE	diagnostic	`=<bytes>` gives the guest an alias region of that size instead of the platform's, which is at least the Switch's 64 GB on the Mac and the profile's `mem_alias` on an iPhone (at least 256 MB, whole host pages; the heap and stacks stay as they are): the profile's value reproduces an iPhone's address space on the Mac, as the NSP script's heap check does; its address region check sets 64 GB (Mac only: an iPhone has no room)
 DM_ALIAS_WINDOWS	diagnostic	`=<MB>` logs every 30 s how much of each window of that size in the alias region is mapped (windows aligned to their size in absolute addresses)
 DM_ALLOW_OTHER_METAL	switch	`1` lets `own_compilers.py` build the shader libraries with a Metal compiler other than the one in `dmsh_chain.lock` (it stops otherwise, GitHub issue #242); the NSP script sets it for `--allow-other-metal`
+DM_ANISO	diagnostic	`0`, `2`, `4`, `8` or `16`: anisotropic filtering of at least that many taps for every filtered, mipmapped sampler the game makes (NVN, GL, Vulkan; the game's own higher value stays; `0` the game's own), taken at the first sampler; a Mac app uses 16 unless the Quick settings sidebar saved another choice for the game, and this wins over both
 DM_AOC_DIR	path	Folder of add-on content: one numbered subfolder per DLC index holding that DLC's RomFS, reported by `aoc` and mounted read-only; the app, the Mac launcher and the NSP script set it when the build has DLC
 DM_AOC_OWNED	switch	`0` reports no add-on content even when `DM_AOC_DIR` has some, for runs without the DLC
 DM_APP_DM	path	Set by the iOS app of a game of several programs: the running program's `dm/p<N>` folder, where the settings screen finds its `launcher.json`
@@ -25,6 +26,8 @@ DM_COPY_ROMFS	switch	`NO` keeps the game files out of the app, in the Xcode buil
 DM_CRASH_PEEK	diagnostic	`="sp+0x248*,x22-0x20"` adds 0x100 bytes at each address to the crash report: `sp` or a register plus or minus an offset, a trailing `*` reading the pointer stored there first
 DM_CTL	diagnostic	`=<file>` (Mac): the host polls the file every 100 ms and runs each appended line: button presses, `shot`, `passdump`, `texdump`, `env KEY=VALUE`, `peek`, `memdump`, `drag` and more
 DM_CTRL_PROMPT_TEXT	switch	The texts of the controller applet's prompt (a game wants more players than have joined; `ctrl_prompt.h`) in the player's language, one per line: the title, the hint, the count, the done and the cancel button, with `{min}`, `{max}` and `{joined}` replaced by the numbers; a front end sets it ([Starting a game](frontends.md#starting-a-game)), an empty or missing line keeps the English text
+DM_CURSOR_HIDE	diagnostic	`=<seconds>` hides the Mac pointer after that many seconds without movement over the game window (3 by default) and shows it again on the next movement, click or scroll, or while Quick settings is open; `0` keeps it
+DM_CV_LATE	diagnostic	`=0` hands out AV1 movie pictures in decode order, one each time the game takes one, instead of by the movie's clock with late pictures skipped (`hle_codec_video.c`)
 DM_DBG	diagnostic	When set, prints the guest's `svcOutputDebugString` text to stderr as `[guest]` lines
 DM_DBG_AU_FRAMES	diagnostic	`=<frames>` asks the Mac's Core Audio output for that many frames per callback instead of about 5 ms (1024 reproduces the iOS default that caused crackling)
 DM_DETCLOCK	switch	`=<step ns>`: from the first present on, the guest clock advances a fixed step per present instead of following the wall clock, and the random source becomes a fixed-seed stream (replay and test runs)
@@ -46,17 +49,19 @@ DM_FORCE_STRICT	diagnostic	`=1` makes the loader fail on forced-hook entries no
 DM_FPS	switch	`30` or `60` pins the frame rate the display link and frame pacing aim for; otherwise it follows the game's present interval (60, or 30 when the game asks for 30)
 DM_FPS_HOLD	player	`on` / `off` overrides the profile's `fps_hold`: whether late frames may raise the hold above the frame cap's vsyncs (on by default)
 DM_FPS_TARGET	player	Frame-rate cap: `30` or `60`, `120` for a game whose profile has `fps_max 120` (60 otherwise), or `0` for the game's own limit; overrides the profile's `fps_target`
+DM_FRAME_TIMES	diagnostic	`1` / `0` records the Mac game's frame times for this run (or not), whatever Quick settings › Record frame times says: timing rows as `DM_NVN_TSV` writes them, to a new file in the game folder's `Frame times` (else `<DM_ROOT>/frame-times`); a `DM_NVN_TSV` the environment sets wins
