+        sites, _ = record_hooks(FUNCTIONS)
+        no_wide, _ = record_hooks(FUNCTIONS | {name: None for name in OTHERS if name.startswith('wide: ')})
+        no_shape, _ = self.baseline()
+        self.assertEqual(len(set(no_wide) & (set(sites) - set(no_shape)) - set(no_shape)), 19)
+        self.assertEqual(len(sites), len(set(sites)))
 
 
