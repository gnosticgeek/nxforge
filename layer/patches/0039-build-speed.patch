+def scratch_folder(work, gid, environ=os.environ):
+    """NXForge: where the shader compiles' and metal-tt's short-lived files go when the build folder is on a volume without APFS clones (an exFAT game drive: it creates and removes
+    a small file about ten times slower than the startup disk, and a shader build makes several per shader): ~/Library/Caches/NXForge/scratch/<title ID>, emptied when the build
+    starts and removed when it ends. None when the build folder is on APFS (its own tmp.noindex is as fast, and stays on the volume the user chose). NXFORGE_SCRATCH=off keeps
+    them in the build folder, NXFORGE_SCRATCH=<folder> names another place. Only temporary files: every cache and output stays in the build folder"""
+    import atexit
+    want = environ.get('NXFORGE_SCRATCH', '')
+    if want == 'off' or sys.platform != 'darwin': return None
+    if want: d = Path(os.path.expanduser(want)) / gid
+    else:
+        try:
+            work.mkdir(parents=True, exist_ok=True)
+            if can_clone(work): return None
+        except OSError: return None
+        d = Path.home() / 'Library/Caches/NXForge/scratch' / gid
+    try: rmtree(d); d.mkdir(parents=True)
+    except OSError: return None
+    atexit.register(shutil.rmtree, d, True)
+    return d
+
