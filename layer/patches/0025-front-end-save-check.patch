From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 16:43:10 +0000
Subject: front-end-save-check: NXForge's Play (--no-launcher) runs the cloud
 save check without the settings window

---
 dm/mac/launcher.c     | 8 +++++---
 docs/env_switches.tsv | 1 +
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/dm/mac/launcher.c b/dm/mac/launcher.c
index e8bb19863562717ce6099d621666f6d514615614..6d66576af8ad524f33d75dba3f581ec4b3844147 100644
--- a/dm/mac/launcher.c
+++ b/dm/mac/launcher.c
@@ -37,6 +37,7 @@
 
 extern char **environ;
 int dm_mac_launcher(void);   // Launcher.swift: 1 = Play (the settings are in the environment), 0 = the player quit, 2 = no window (apply the saved choices here)
+int dm_mac_save_check(void);   // NXForge (dm/mac/nxforge/launcher_window.swift): the cloud save check alone, for --no-launcher: 2 = go on, 0 = the player quit
 static pid_t g_child;
 static char *g_file_keys, *g_launch_keys;   // the variables the env files set, and the settings the launch environment set (DM_ENV_FILE_KEYS, DM_ENV_LAUNCH_KEYS)
 
@@ -304,9 +305,10 @@ int main(int argc, char **argv) {
     fprintf(stderr, "launcher: save %s\n", getenv("DM_SAVE") ?: save);
     setenv("DM_SAVE", save, 0);   // before the window (and after the save moved into the game folder): its cloud-save check compares this save with the cloud's (Launcher.swift SaveCheck)
     int window = !(getenv("DM_LAUNCHER") && !strcmp(getenv("DM_LAUNCHER"), "0"));
-    for (int i = 1; i < argc; i++) if (!strcmp(argv[i], "--no-launcher")) window = 0;
-    if (!window) fprintf(stderr, "launcher: no settings window (DM_LAUNCHER=0 or --no-launcher)\n");
-    int shown = window ? dm_mac_launcher() : 2;
+    int no_launcher = 0;   // NXForge: --no-launcher (NXForge's Play) still checks the cloud save; DM_LAUNCHER=0 asks nothing, as before
+    for (int i = 1; i < argc; i++) if (!strcmp(argv[i], "--no-launcher")) no_launcher = 1;
+    if (no_launcher || !window) fprintf(stderr, "launcher: no settings window (DM_LAUNCHER=0 or --no-launcher)\n");
+    int shown = no_launcher && window ? dm_mac_save_check() : window ? dm_mac_launcher() : 2;
     if (!shown) return 0;   // Quit: no game
     if (shown == 2) saved_choices();
     cloud_saves_folder();
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index 11aeaf04b3d05d29a98a0563f300ae617f2c4dc3..27e0724acce95f97dd09f857d4a1480c1d5690b6 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -49,6 +49,7 @@ DM_FPS	switch	`30` or `60` pins the frame rate the display link and frame pacing
 DM_FPS_HOLD	player	`on` / `off` overrides the profile's `fps_hold`: whether late frames may raise the hold above the frame cap's vsyncs (on by default)
 DM_FPS_TARGET	player	Frame-rate cap: `30` or `60`, `120` for a game whose profile has `fps_max 120` (60 otherwise), or `0` for the game's own limit; overrides the profile's `fps_target`
 DM_FRAME_TIMES	diagnostic	`1` / `0` records the Mac game's frame times for this run (or not), whatever Quick settings › Record frame times says: timing rows as `DM_NVN_TSV` writes them, to a new file in the game folder's `Frame times` (else `<DM_ROOT>/frame-times`); a `DM_NVN_TSV` the environment sets wins
+DM_FRONT_END_FADE	switch	`0` shows the game window at once when NXForge's Play started the game; by default it stays see-through until the game's first frame (at most 15 s), so NXForge's launch screen leads straight into the picture
 DM_FS	diagnostic	When set, logs file opens, paths not found or not mounted, and a read summary every 64 MiB or 1000 reads
 DM_FSLOG	diagnostic	`=<file>` writes one TSV line per ReadFile: seconds since boot, guest path, offset, length and guest buffer address
 DM_FSLOG_HASH	diagnostic	With `DM_FSLOG`, adds a column with the FNV-1a 64 hash of the bytes read
