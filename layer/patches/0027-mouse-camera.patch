+// NXForge mouse camera (DM_MOUSE_CAMERA=1, the Mouse camera row; DM_MOUSE_CAMERA_SPEED 0.25 to 4, 1 by default): while the right mouse button is held over the game, the pointer
+// stays where it is, hidden, and its movement is the right stick, added to the keyboard's. Each 8 ms the movement since the last tick becomes a deflection (about 2,500 points a
+// second is a full one at speed 1), smoothed over two ticks, so a still mouse lets the stick go back to the middle within about 30 ms. The left button stays the touch screen
+static int g_mcam = -1, g_mcam_held; static double g_mcam_k = 1, g_mcam_dx, g_mcam_dy, g_mrx, g_mry; static dispatch_source_t g_mcam_timer;
+static int32_t stick_clamp(double v) { return v > 32767 ? 32767 : v < -32767 ? -32767 : (int32_t)v; }
 static void push(void) {
     int32_t lx = (g_d - g_a) * 32767, ly = (g_w - g_s) * 32767;
-    int32_t rx = (g_rr - g_rl) * 32767, ry = (g_ru - g_rd) * 32767;
+    int32_t rx = stick_clamp((g_rr - g_rl) * 32767 + g_mrx), ry = stick_clamp((g_ru - g_rd) * 32767 + g_mry);
     dm_input_set(g_btn, lx, ly, rx, ry);
 }
 // Key and controller map (the sidebar's Controls section, quick_settings_mac.swift; saved per game). Actions 0–15 are the NpadButton bits (dm_input.h: A B X Y, the stick presses,
@@ -499,7 +504,33 @@ static void pads_reread(void) {
     for (jc1_pad *d = g_jc1_pads; d; d = d->next) jc1pad_read(d);
 }
 static void hq_close(void);
+static int mcam_on(void) {
+    if (g_mcam < 0) { const char *e = getenv("DM_MOUSE_CAMERA"); g_mcam = e && atoi(e) > 0;
+        const char *k = getenv("DM_MOUSE_CAMERA_SPEED"); double v = k && *k ? strtod(k, NULL) : 1; g_mcam_k = v >= 0.25 && v <= 4 ? v : 1;
+        if (g_mcam) LOG("front end: mouse camera on (hold the right mouse button; speed %.2f)", g_mcam_k); }
+    return g_mcam;
+}
+static void mcam_release(void) {   // the button up, focus lost, or the sidebar open: the pointer free again, the stick back in the middle
+    if (!g_mcam_held) return;
+    g_mcam_held = 0; CGAssociateMouseAndMouseCursorPosition(true); [NSCursor unhide];
+    if (g_mcam_timer) { dispatch_source_cancel(g_mcam_timer); g_mcam_timer = nil; }
+    g_mcam_dx = g_mcam_dy = g_mrx = g_mry = 0; push();
+}
+static void mcam_hold(void) {
+    if (g_mcam_held || !mcam_on() || !g_input_on) return;
+    g_mcam_held = 1; g_mcam_dx = g_mcam_dy = 0; CGAssociateMouseAndMouseCursorPosition(false); [NSCursor hide];
+    g_mcam_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+    dispatch_source_set_timer(g_mcam_timer, dispatch_time(DISPATCH_TIME_NOW, 8 * NSEC_PER_MSEC), 8 * NSEC_PER_MSEC, NSEC_PER_MSEC);
+    dispatch_source_set_event_handler(g_mcam_timer, ^{
+        double full = 20.0 / g_mcam_k;   // points in 8 ms for a full deflection
+        g_mrx = 0.5 * g_mrx + 0.5 * stick_clamp(g_mcam_dx / full * 32767); g_mry = 0.5 * g_mry + 0.5 * stick_clamp(-g_mcam_dy / full * 32767);   // AppKit's deltaY grows downwards
+        if (fabs(g_mrx) < 300) { g_mrx = 0; }
+        if (fabs(g_mry) < 300) { g_mry = 0; }
+        g_mcam_dx = g_mcam_dy = 0; push(); });
+    dispatch_resume(g_mcam_timer);
+}
 static void input_release(void) {
+    mcam_release();
     hq_close();   // the prompt or the hold indicator, if one is up: the Games app the system opens for Home takes the focus too
     [NSCursor setHiddenUntilMouseMoves:NO];
     display_awake(0);
@@ -890,6 +921,9 @@ void front_picture_shape(int w, int h) { if (w > 0 && h > 0) g_picture_aspect =
     dm_touch_set(&t, 1); g_mouse_down = 1;
 }
 - (void)mouseUp:(NSEvent *)e { (void)e; if (g_mouse_down) { g_mouse_down = 0; dm_touch_set(NULL, 0); } }
+- (void)rightMouseDown:(NSEvent *)e { if (mcam_on()) mcam_hold(); else [super rightMouseDown:e]; }   // NXForge mouse camera (above)
+- (void)rightMouseDragged:(NSEvent *)e { if (g_mcam_held) { g_mcam_dx += e.deltaX; g_mcam_dy += e.deltaY; } else [super rightMouseDragged:e]; }
+- (void)rightMouseUp:(NSEvent *)e { if (g_mcam_held) mcam_release(); else [super rightMouseUp:e]; }
