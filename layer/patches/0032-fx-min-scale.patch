From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NXForge layer <layer@nxforge.invalid>
Date: Mon, 16 Nov 2026 21:57:12 +0000
Subject: fx-min-scale: MetalFX only where it enlarges the picture by 1.4x or
 more (DM_FX_MIN_SCALE)

---
 dm/gfx/nvn/nvn_mtl.m | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index ba00e5d7480913c0172e0f4b12d42912c3e28a80..4d8d083ecffaa8a4d838e11318fde40cac2f66bb 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -22219,9 +22219,10 @@ static id<MTLTexture> aa_encode(fx_state *fx, id<MTL4CommandBuffer> cb, id<MTLTe
     return fx->aa;
 }
 // MetalFX scales the content (cw x ch) to its rectangle on the canvas (vp) when the rectangle is at least as large in both directions and larger in one
+#include "nxforge/fx_min_scale.inc"   // NXForge: MetalFX only where it scales the picture by a useful amount
 static int fx_wanted(MTLViewport vp, NSUInteger cw, NSUInteger ch) {
     NSUInteger w = (NSUInteger)vp.width, h = (NSUInteger)vp.height;
-    return cw && ch && w >= cw && h >= ch && (w > cw || h > ch);
+    return cw && ch && w >= cw && h >= ch && (w > cw || h > ch) && nxf_fx_scale_ok(cw, ch, w, h);
 }
 // A texture of the scaler's own (private, resident), made on first use; nil when it cannot be made
 static id<MTLTexture> fx_tex(__strong id<MTLTexture> *slot, MTLPixelFormat pf, NSUInteger w, NSUInteger h, MTLTextureUsage usage, NSString *label) {
