     if (!g_res) return;
-    if (ws && !(e && !lim)) { g_guard.wall = MAX(ws, lim); g_guard.stop = lim ? lim : ws / 100 * 95; g_guard.evict = g_guard.stop / 95 * 80;
+    if (ws && !(e && !lim)) { g_guard.wall = MAX(ws, lim); g_guard.stop = lim ? lim : ws / 100 * 95; g_guard.evict = lim ? g_guard.stop / 95 * 80 : rule_ws() / 100 * 80;   // NXForge: letting go begins by what the player plans for (rule_ws), stopping by the device
