+    EXPECT("paper white 250", 250, hdr_paper_white_parse("250"));
+    EXPECT("paper white 79: refused", -1, hdr_paper_white_parse("79")); EXPECT("paper white 1001: refused", -1, hdr_paper_white_parse("1001"));
