-static void *jit_grow(void *p, size_t n) { void *q = realloc(p, n); if (!q) die("jit: out of memory"); return q; }
 static void jit_serve_load(const char *dir) {
     char path[1100]; snprintf(path, sizeof path, "%s/jit.tsv", dir);
     FILE *f = fopen(path, "r"); if (!f) die("jit: no %s", path);
@@ -120,7 +120,7 @@ static void jit_serve_load(const char *dir) {
         unsigned oe, oc, os2;
         if (sscanf(line, "outcode\t%u\t%x\t%x\t%x", &kc, &oe, &oc, &os2) == 4 && kc < 8) { g_outcode[kc].set = 1; g_outcode[kc].entries = oe; g_outcode[kc].count = oc; g_outcode[kc].size = os2; continue; }
         if (strncmp(line, "req\t", 4)) continue;
-        g_req = jit_grow(g_req, (size_t)(g_nreq + 1) * sizeof *g_req); jit_req *r = &g_req[g_nreq++]; memset(r, 0, sizeof *r);
+        g_req = jit_grow(g_req, (size_t)(g_nreq + 1) * sizeof *g_req, path); jit_req *r = &g_req[g_nreq++]; memset(r, 0, sizeof *r);
         char rel[16]; unsigned long long co, cs, roo, ros, oo, os; int off = 0;
         if (sscanf(line, "req\t%32s\t%llu\t%llx\t%llx\t%llx\t%llx\t%d\t%llx\t%llx\t%n", r->key, (unsigned long long *)&r->cmd, &co, &cs, &roo, &ros, &r->ret, &oo, &os, &off) < 9 || !off) die("%s: bad row", path);
         r->code_off = co; r->code_size = cs; r->ro_off = roo; r->ro_size = ros; r->out_off = oo; r->out_size = os;
@@ -129,7 +129,7 @@ static void jit_serve_load(const char *dir) {
             unsigned long long at, ro2; char nm[17]; int k = 0;
             if (sscanf(q, "%llx=%16[^+]+%llx%n", &at, nm, &ro2, &k) != 3) die("%s: bad relocation in %s", path, r->key);
             int mi = -1; if (strcmp(nm, "jit_rx")) { for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, nm)) mi = i; if (mi < 0) die("%s: relocation into %s, which is not loaded", path, nm); }
-            r->rel_at = jit_grow(r->rel_at, (r->nrel + 1) * 8); r->rel_off = jit_grow(r->rel_off, (r->nrel + 1) * 8); r->rel_mod = jit_grow(r->rel_mod, (r->nrel + 1) * sizeof(int));
+            r->rel_at = jit_grow(r->rel_at, (r->nrel + 1) * 8, path); r->rel_off = jit_grow(r->rel_off, (r->nrel + 1) * 8, path); r->rel_mod = jit_grow(r->rel_mod, (r->nrel + 1) * sizeof(int), path);
             r->rel_at[r->nrel] = at; r->rel_off[r->nrel] = ro2; r->rel_mod[r->nrel] = mi; r->nrel++;
             q += k; if (*q == ',') q++;
         }
diff --git a/dm/host/hle_sdk16.c b/dm/host/hle_sdk16.c
index 96abc5aabc8d0d5145945926ce940dd776761118..67e81d198e706c7d17a6604024cd692f6f2e68ed 100644
--- a/dm/host/hle_sdk16.c
+++ b/dm/host/hle_sdk16.c
@@ -343,7 +343,10 @@ HLE_FORCE("_ZN2nn4diag6detail7PutImplERKNS0_11LogMetaDataEPKcm", "game log → h
 static void diag_abort(uint32_t res, void *lr) {
     module_t *m = module_of(lr);
     LOG("game called nn::diag abort: Result %#x, call site %s+%#llx", res, m ? m->name : "?", m ? (unsigned long long)((uint8_t *)lr - m->base) : (unsigned long long)(uintptr_t)lr);
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wframe-address"   // the caller's frame: the guest code that called abort, whose frame chain the backtrace walks
     dm_backtrace((uint64_t)__builtin_frame_address(1));
+#pragma clang diagnostic pop
     die("game aborted");
 }
 HLE_FORCE("_ZN2nn4diag6detail9AbortImplEv", "game aborted", void, h_diag_Abort0, void) { diag_abort(0, dm_bigstack_caller(__builtin_return_address(0))); }
diff --git a/dm/host/tests/t_condvar.c b/dm/host/tests/t_condvar.c
index 90a06e712a2eb55464fec80d097d5586541f9d06..95bd93c2c0077feca91c423eca588947933ed229 100644
--- a/dm/host/tests/t_condvar.c
+++ b/dm/host/tests/t_condvar.c
@@ -28,9 +28,9 @@ static void *reader(void *a) {
     uint32_t z = 0; while (!atomic_compare_exchange_strong(&g_mutex, &z, g_rtag)) { z = 0; sched_yield(); }   // grab the lock in user mode
     state_set(1);
     // (here R changes the condition: for example decrementing the reader count to 0)
-    if (atomic_load(&g_key)) { state_set(2); uint64_t r[31] = {(uint64_t)&g_key, 1}; svc_thread(0x1D, r); }   // Signal fast path: key 0 sends no svc
+    if (atomic_load(&g_key)) { state_set(2); uint64_t r[32] = {(uint64_t)&g_key, 1}; svc_thread(0x1D, r); }   // Signal fast path: key 0 sends no svc
     uint32_t v = g_rtag;
-    if (!atomic_compare_exchange_strong(&g_mutex, &v, 0)) { uint64_t r[31] = {(uint64_t)&g_mutex}; svc_thread(0x1B, r); }      // waiter bit set => ArbitrateUnlock
+    if (!atomic_compare_exchange_strong(&g_mutex, &v, 0)) { uint64_t r[32] = {(uint64_t)&g_mutex}; svc_thread(0x1B, r); }      // waiter bit set => ArbitrateUnlock
     state_set(3);
     return NULL;
 }
@@ -44,7 +44,7 @@ static void *waiter(void *a) {
     g_wtag = svc_thread_main_init();
     uint32_t z = 0; atomic_compare_exchange_strong(&g_mutex, &z, g_wtag);                 // W holds the lock
     dm_test_cv_after_release = hook;
-    uint64_t r[31] = {(uint64_t)&g_mutex, (uint64_t)&g_key, g_wtag, (uint64_t)-1};
+    uint64_t r[32] = {(uint64_t)&g_mutex, (uint64_t)&g_key, g_wtag, (uint64_t)-1};
     svc_thread(0x1C, r);
     pthread_mutex_lock(&g_m); g_wret = (int64_t)r[0]; g_wlock_after = atomic_load(&g_mutex); g_wdone = 1; pthread_cond_broadcast(&g_c); pthread_mutex_unlock(&g_m);
     return NULL;
