+def cbz_w(frm, to, rt):   # cbz wt, to
+    off = to - frm
+    assert -(1 << 20) <= off < (1 << 20) and off % 4 == 0
+    return 0x34000000 | (((off >> 2) & 0x7FFFF) << 5) | rt
