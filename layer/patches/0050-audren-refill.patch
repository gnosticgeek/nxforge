+enum { CQ = 4, AR_MAX = 4, RENDER_MIN_NS = 4500000, RENDER_REFILL_NS = 2500000, REFILL_BELOW = 2 };   // AR_MAX as g_rev below
 typedef struct {
     void *handle[2];                         // AudioRendererHandle (renderer object, client state); handle[0] NULL: a free slot
     uint8_t *sys;                            // its AudioRenderSystem, from its first render or update (ar_of_sys)
@@ -171,8 +172,16 @@ static void render_main(void *arg) {
     for (int i = 0; i < NBUF; i++) { a->bufs[i] = (aout_buf){.ptr = a->pcm[i], .cap = sizeof a->pcm[i], .size = 0}; free_list[i] = &a->bufs[i]; }
     dm_pcmout_start(out);
     LOG("audren: render thread %d started (%d buffers in flight, paced by the output)", ar_index(a), NBUF);
-    uint64_t next_exec = 0;
+    uint64_t next_exec = 0, last_exec = 0;
     int prefill = NBUF;
+    // Refill: once fewer than REFILL_BELOW blocks are queued at the output, the gap between renders is RENDER_REFILL_NS rather than RENDER_MIN_NS until all NBUF are queued again. The 4.5 ms gap is only
+    // 0.5 ms shorter than the 5 ms a block plays for, so a wake-up that comes 0.5 ms late each time made the renderer exactly as fast as the sound card: once a hiccup had
+    // taken the queue down to one block it stayed there, and every late wake-up after that was a gap of silence (about 3 a second for 25 minutes in Ocarina of Time,
+    // heard as crunching behind the music, until a route change let the queue fill again). At 2.5 ms the renderer is twice as fast as the card while short, so it
+    // gets back to NBUF blocks in a few frames and keeps the usual gap from then on. DM_AUDREN_REFILL=0 keeps 4.5 ms throughout (for an A/B run)
+    const char *refill_env = getenv("DM_AUDREN_REFILL");
+    int refill = !refill_env || atoi(refill_env) != 0;
+    uint64_t refills = 0; int refilling = 0;
     int rt = render_rt();
     while (atomic_load(&a->open)) {
