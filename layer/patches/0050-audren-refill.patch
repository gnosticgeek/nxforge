@@ -497,13 +511,13 @@ static int wait_for_render(pthread_cond_t *cv, pthread_mutex_t *mu, const struct
         while (a->cq_head == a->cq_tail) assert(!pthread_cond_timedwait_relative_np(cv, mu, &timeout));
         return 0;
     }
-    pace_advance(pace.now + (uint64_t)delay->tv_nsec);
+    pace_advance(pace.now + (uint64_t)delay->tv_nsec + pace.overshoot_ns);
     return ETIMEDOUT;
 }
-static void test_render_cadence(int rate, int frames) {
+static void pace_run(void) {
     ar_t *a = &g_ar[0];
     memset(a, 0, sizeof *a);
-    pace.rate = rate; pace.device_frames = frames; pace.min_spacing = UINT64_MAX;
+    pace.min_spacing = UINT64_MAX;
     *(int32_t *)(pace_sys + 0x48) = *(int32_t *)(pace_sys + 0x4c) = 1;
     a->sys = pace_sys; a->handle[0] = pace_sys;
     lock_plt_stub();
@@ -515,12 +529,35 @@ static void test_render_cadence(int rate, int frames) {
     atomic_store(&a->open, 1);
     render_main(a);
     assert(!pthread_join(pace.catchup, NULL));
+    pthread_cond_destroy(&a->cq_cv); pthread_mutex_destroy(&a->cq_mu);
+}
+static void test_render_cadence(int rate, int frames) {
+    ar_t *a = &g_ar[0];
+    pace.rate = rate; pace.device_frames = frames;
+    pace_run();
     assert(pace.waits > 1 && pace.bursts > 1);
     assert(atomic_load(&a->catchups) == 1 && a->cq_head == a->cq_tail);
     assert(pace.appended == PACE_BLOCKS && pace.rendered == PACE_BLOCKS);
     printf("audren cadence: %d Hz/%d device frames, %d callbacks (%d burst releases), %d PCM blocks in order, min exec spacing %.2f ms, no underruns\n",
            rate, frames, pace.callbacks, pace.bursts, pace.appended, pace.min_spacing / 1e6);
-    pthread_cond_destroy(&a->cq_cv); pthread_mutex_destroy(&a->cq_mu);
+    memset(&pace, 0, sizeof pace);
+}
+// Ocarina of Time on a MacBook Pro's speakers (240-frame callbacks): a hiccup took the output down to one block, and for 25 minutes the sound card found 1.0 blocks on
+// average and zero-filled about 3 callbacks a second (crunching behind the music). With the 4.5 ms gap, timed waits that wake 0.6 ms late make the renderer no faster
+// than the card, so the queue never fills again; the refill gap brings it back to NBUF blocks within a few frames. Here the render thread is held 20 ms in block 200's
+// render; the depth and the underruns are counted from callback 400 (2 s in) to the end of the 2000 blocks
+static void test_render_refill(int on) {
+    if (!on) setenv("DM_AUDREN_REFILL", "0", 1);
+    pace.rate = 48000; pace.device_frames = 240; pace.lenient = 1;
+    pace.overshoot_ns = 600000; pace.stall_at = 200; pace.stall_ns = 20000000; pace.depth_from = 400;
+    pace_run();
+    double depth = (double)pace.depth_sum / (double)pace.depth_n;
+    printf("audren refill %s: wakes 0.6 ms late, render thread held 20 ms at block 200: %d underruns in all, %d after callback 400, %.2f blocks queued on average there, %d renders at the refill gap\n",
+           on ? "on" : "off (DM_AUDREN_REFILL=0)", pace.underruns, pace.late_underruns, depth, pace.refill_execs);
+    assert(pace.underruns > 0);   // the hold itself drains the queue either way
+    if (on) assert(pace.late_underruns == 0 && depth > 3.5 && pace.refill_execs > 0 && pace.refill_execs < 20);
+    else assert(pace.late_underruns > 20 && depth < 1.5 && pace.refill_execs == 0);
+    unsetenv("DM_AUDREN_REFILL");
     memset(&pace, 0, sizeof pace);
 }
 
@@ -530,6 +567,7 @@ int main(int argc, char **argv) {
         test_render_cadence(48000, 512);
         return 0;
     }
+    if (argc == 2 && !strcmp(argv[1], "--refill")) { test_render_refill(0); test_render_refill(1); return 0; }
     test_update_lock();
     test_two_renderers();
     test_render_policy();
@@ -554,6 +592,8 @@ int main(int argc, char **argv) {
     test_histogram();
     test_render_cadence(44100, 256);
     test_render_cadence(48000, 512);
