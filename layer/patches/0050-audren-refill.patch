         dm_host_lock(&a->cq_mu);
         // Leave some slack below the 5 ms block duration. Device callbacks can return several blocks at once,
-        // but back-to-back SDK renders can coalesce their events before the game can update.
+        // but back-to-back SDK renders can coalesce their events before the game can update. A short output queue takes the refill gap instead (above)
+        unsigned q = refill && !prefill ? dm_pcmout_queued(out) : NBUF;
+        if (q < REFILL_BELOW) refilling = 1; else if (q >= NBUF) refilling = 0;
+        int short_q = refilling;
+        uint64_t due = short_q ? last_exec + RENDER_REFILL_NS : next_exec;
         while (!prefill && a->cq_head == a->cq_tail && atomic_load(&a->open)) {
             uint64_t now = now_ns();
-            if (now >= next_exec) break;
-            struct timespec delay = { .tv_nsec = (long)(next_exec - now) };
+            if (now >= due) break;
+            struct timespec delay = { .tv_nsec = (long)(due - now) };
             pthread_cond_timedwait_relative_np(&a->cq_cv, &a->cq_mu, &delay);
         }
         if (!atomic_load(&a->open)) { pthread_mutex_unlock(&a->cq_mu); break; }
@@ -199,7 +212,10 @@ static void render_main(void *arg) {
             uint32_t slot = a->cq_head % CQ;
             src = a->cq[slot]; got = a->cq_n[slot];
         } else {
-            next_exec = now_ns() + RENDER_MIN_NS;
+            last_exec = now_ns(); next_exec = last_exec + RENDER_MIN_NS;
+            if (short_q && ++refills <= 3) LOG("audren: renderer %d: the output is down to fewer than %d blocks, rendering %.1f ms apart until it is full again (%llu so far)",
+                                               ar_index(a), REFILL_BELOW, RENDER_REFILL_NS / 1e6, (unsigned long long)refills);
+            else if (short_q && refills % 2000 == 0) LOG("audren: renderer %d: %llu renders so far with the output short (refill gap)", ar_index(a), (unsigned long long)refills);
             a->frame_n = 0;
             exec(a->handle[0], a->handle[1]);   // SDK: generate commands → CPU processing → signal the game's renderer event
