diff --git a/dm/host/tests/t_audren_layout.c b/dm/host/tests/t_audren_layout.c
index 73354d4b7f5445d1f3d23eb1eb4a7c357ee35265..176964bc2c024a11c6a0934ac3eb50a82ff9614c 100644
--- a/dm/host/tests/t_audren_layout.c
+++ b/dm/host/tests/t_audren_layout.c
@@ -38,6 +38,9 @@ enum { PACE_BLOCKS = 2000 };
 static struct {
     int rate, device_frames, callbacks, played, released, appended, rendered, bursts, waits;
     uint64_t now, last_exec, min_spacing;
+    // test_render_refill: underruns allowed and counted (lenient), every timed wait wakes overshoot_ns late, the render thread is held stall_ns in the render of block stall_at,
+    // and the queue depth the sound card finds is summed from callback depth_from on
+    int lenient, underruns, late_underruns, stall_at, refill_execs, depth_from; uint64_t wanted, overshoot_ns, stall_ns, depth_sum, depth_n;
     aout_buf *output[NBUF];
     pthread_t catchup;
 } pace;
@@ -88,15 +91,24 @@ int dm_pcmout_append(void *k, void *b) {
 // Advance by whole device callbacks. Fractional resampling is carried across callbacks,
 // so 44.1 kHz consumes alternating counts of 48 kHz samples as CoreAudio does.
 static uint64_t next_callback(void) { return (uint64_t)(pace.callbacks + 1) * pace.device_frames * 1000000000ull / pace.rate; }
+static int pace_queued(void) { return pace.appended - pace.played / SAMPLES; }   // as queued_pcm_blocks: appended and not yet played to the end
 static void pace_advance(uint64_t until) {
     while (next_callback() <= until) {
         int before = pace.played / SAMPLES;
-        pace.played = (int)((uint64_t)++pace.callbacks * pace.device_frames * 48000 / pace.rate);
-        assert(pace.played <= pace.appended * SAMPLES);   // no zero-fill needed
+        if (pace.callbacks >= pace.depth_from) { pace.depth_sum += (uint64_t)pace_queued(); pace.depth_n++; }
+        uint64_t wanted = (uint64_t)++pace.callbacks * pace.device_frames * 48000 / pace.rate, want = wanted - pace.wanted, have = (uint64_t)(pace.appended * SAMPLES - pace.played);
+        pace.wanted = wanted;
+        if (want > have) {   // the sound card's zero fill: what is queued plays and the rest of the callback is silence
+            assert(pace.lenient);
+            pace.underruns++; if (pace.callbacks >= pace.depth_from) pace.late_underruns++;
+            want = have;
+        }
+        pace.played += (int)want;
         if (pace.played / SAMPLES - before > 1) pace.bursts++;
     }
     pace.now = until;
 }
+unsigned dm_pcmout_queued(void *k) { (void)k; return pace.rate ? (unsigned)pace_queued() : 0; }
 void *dm_pcmout_released(void *k) {
     (void)k;
     return pace.released < pace.played / SAMPLES ? pace.output[pace.released++ % NBUF] : NULL;
@@ -463,11 +475,13 @@ static void pace_exec(void *sys, void *state) {
     (void)state;
     if (pace.appended >= NBUF) {
         uint64_t gap = pace.now - pace.last_exec;
-        assert(gap >= 4500000);
+        assert(gap >= RENDER_REFILL_NS);   // the refill gap with the output short, else the usual 4.5 ms
+        if (gap < RENDER_MIN_NS) pace.refill_execs++;
         if (gap < pace.min_spacing) pace.min_spacing = gap;
     }
     pace.last_exec = pace.now;
     assert(h_ars_Exec(sys) == RES_OK);
+    if (pace.stall_at && pace.rendered == pace.stall_at) pace_advance(pace.now + pace.stall_ns);   // the render thread held up in this render (the queue drains meanwhile)
 }
