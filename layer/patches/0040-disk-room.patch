+    def test_a_short_startup_disk_lowers_the_limit(self):   # NXForge: the startup disk filled during builds (2026-11-21)
+        self.assertEqual(dmsh_mtlcache.spare_limit(12, 100), 12)
+        self.assertEqual(dmsh_mtlcache.spare_limit(12, 25), 7)    # 5 GB short of 30
+        self.assertEqual(dmsh_mtlcache.spare_limit(12, 2), 4)     # never under the floor
+        self.assertEqual(dmsh_mtlcache.spare_limit(3, 2), 3)      # nor over the limit set
+        self.assertEqual(dmsh_mtlcache.spare_limit(12, None), 12)
+        for i, text in enumerate(('old', 'new')):
+            self.cache.compile('mac', self.source(f'{text}.metal', text * 5000), str(self.root / f'{text}.metallib'))
+            self.store._run('UPDATE entry SET mtime=? WHERE name=?', 1000 + i, self.cache.path('mac', (text * 5000).encode()))
+        self.cache.used.pop(self.cache.path('mac', (b'old' * 5000)))
+        size = len(b'LIB ' + b'old' * 5000) / 2**30
+        with mock.patch.object(dmsh_mtlcache, 'spare_limit', lambda limit, free: 1.5 * size), mock.patch.object(dmsh_mtlcache, 'free_gb', lambda p: 1.0):
+            line = self.cache.prune(10 * size)
+        self.assertFalse(self.store.has(self.cache.path('mac', b'old' * 5000)))
+        self.assertIn('the disk is short of space', line)
