+class Scratch(unittest.TestCase):   # NXForge: temporary files off an exFAT game drive, but only to a startup disk with room (it filled during builds, 2026-11-21)
+    def setUp(self):
+        self.td = tempfile.TemporaryDirectory(); self.home = Path(self.td.name) / 'home'; self.work = Path(self.td.name) / 'game/X_build'
+        self.p = [mock.patch.object(nsp.sys, 'platform', 'darwin'), mock.patch.object(nsp, 'can_clone', lambda p: False), mock.patch.object(nsp.Path, 'home', lambda: self.home),
+                  mock.patch('atexit.register', lambda *a: None)]
+        for x in self.p: x.start()
+
+    def tearDown(self):
+        for x in self.p: x.stop()
+        self.td.cleanup()
+
+    def test_roomy_startup_disk_takes_the_scratch(self):
+        with mock.patch.object(nsp, 'free_gb', lambda p: 100):
+            self.assertEqual(nsp.scratch_folder(self.work, '0100', {}), self.home / 'Library/Caches/NXForge/scratch/0100')
+
+    def test_short_startup_disk_leaves_it_in_the_build_folder(self):
+        with mock.patch.object(nsp, 'free_gb', lambda p: nsp.SCRATCH_MIN_GB - 1):
+            self.assertIsNone(nsp.scratch_folder(self.work, '0100', {}))
+
 if __name__ == '__main__':
     unittest.main()
