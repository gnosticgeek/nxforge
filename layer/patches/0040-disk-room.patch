--- a/dm/gfx/tools/dmsh_mtlcache.py
+++ b/dm/gfx/tools/dmsh_mtlcache.py
@@ -22,6 +22,22 @@ LEGACY = os.path.expanduser('~/Library/Caches/NXForge/metallib')   # the shared
 # so the next chain change compiled 12,000 of them again. prune() also never goes below what this build used
 LIMIT_GB = float(os.environ.get('DMSH_MTLCACHE_GB') or 12)
 
+# NXForge: the shared cache is on the startup disk, which a game on an external drive otherwise leaves alone. When that disk has less than ROOMY_GB free after a build,
+# the cache gives back the shortfall (down to FLOOR_GB): a library compiled again later costs seconds, a full startup disk stops the next build and the Mac.
+ROOMY_GB, FLOOR_GB = 30.0, 4.0
+
+
+def spare_limit(limit_gb, free):
+    """The cache's limit for a disk with free GB free: limit_gb, less what the disk is short of ROOMY_GB, never under FLOOR_GB (nor over limit_gb). free None: limit_gb"""
+    if free is None: return limit_gb
+    return min(limit_gb, max(FLOOR_GB, limit_gb - max(0.0, ROOMY_GB - free)))
+
+
+def free_gb(path):
+    try: return shutil.disk_usage(path).free / 2**30
+    except OSError: return None
+
+
 FORMAT = b'dmsh_mtlcache 3'   # 3-way cut stores _b / _bx / _bf from one compile (fetch fold); earlier formats cannot be reused
