@@ -3550,10 +3550,14 @@ def mac_pso(py, repo, work, lib, g, gpus, env, logs):
 PSO_BASE_JOBS = int(os.environ.get('DM_PSO_BASE_JOBS') or 1)   # NXForge: metal-tt runs at a time for the pipeline archive's batches of bases (pso_offline.py --base-jobs)
 
 
+SCRATCH_MIN_GB = 25   # NXForge: the startup disk's free GB under which scratch_folder leaves the temporary files on the game drive
+
+
 def scratch_folder(work, gid, environ=os.environ):
     """NXForge: where the shader compiles' and metal-tt's short-lived files go when the build folder is on a volume without APFS clones (an exFAT game drive: it creates and removes
     a small file about ten times slower than the startup disk, and a shader build makes several per shader): ~/Library/Caches/NXForge/scratch/<title ID>, emptied when the build
-    starts and removed when it ends. None when the build folder is on APFS (its own tmp.noindex is as fast, and stays on the volume the user chose). NXFORGE_SCRATCH=off keeps
+    starts and removed when it ends. None when the build folder is on APFS (its own tmp.noindex is as fast, and stays on the volume the user chose), or when the startup disk has
+    under SCRATCH_MIN_GB free. NXFORGE_SCRATCH=off keeps
     them in the build folder, NXFORGE_SCRATCH=<folder> names another place. Only temporary files: every cache and output stays in the build folder"""
     import atexit
     want = environ.get('NXFORGE_SCRATCH', '')
@@ -3565,6 +3569,11 @@ def scratch_folder(work, gid, environ=os.environ):
             if can_clone(work): return None
         except OSError: return None
         d = Path.home() / 'Library/Caches/NXForge/scratch' / gid
+        # the startup disk must have room for them: a shader build's temporary files reach several GB, and with the shared Metal cache growing on the same disk a
+        # nearly full startup disk ran out during a build (2026-11-21); the slower game drive is the better place then
+        try: home_free = free_gb(Path.home())
+        except OSError: home_free = 0
+        if home_free < SCRATCH_MIN_GB: return None
     try: rmtree(d); d.mkdir(parents=True)
     except OSError: return None
     atexit.register(shutil.rmtree, d, True)
