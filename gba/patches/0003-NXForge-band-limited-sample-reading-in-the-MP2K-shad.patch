 /// Fetch source sample `idx` as a float in s8 units.
+/// NXForge: `sample_voice` through the band-limited interpolator. Same play-head and loop handling; the window
+/// around the head reads past the end into the loop (or silence for a one-shot) and before the start as silence.
+fn sample_voice_hq(v: &mut Voice, mem: &MemView, buf: &mut [f32; 4 * crate::interp::HALF * 2 + 2]) -> f32 {
+    if v.pos >= v.size as f64 {
+        if v.looped && v.size > v.loop_start {
+            let span = (v.size - v.loop_start) as f64;
+            let over = (v.pos - v.loop_start as f64) % span;
+            v.pos = v.loop_start as f64 + over;
+        } else {
+            return 0.0;
+        }
+    }
+    let (pos, step) = (v.pos, v.step);
+    v.pos += v.step;
+    let out = crate::interp::sample(pos, step, buf, |lo, out| {
+        let n = out.len() as i64;
+        if !v.compressed && lo >= 0 && lo + n <= v.size as i64 {
+            if let Some(b) = mem.slice(v.data + lo as u32, n as usize) {
+                for (o, &x) in out.iter_mut().zip(b) {
+                    *o = x as i8 as f32;
+                }
+                return;
+            }
+        }
+        for (k, o) in out.iter_mut().enumerate() {
+            let mut j = lo + k as i64;
+            if j < 0 {
+                *o = 0.0;
+                continue;
+            }
+            if j >= v.size as i64 {
+                if v.looped && v.size > v.loop_start {
+                    j = v.loop_start as i64 + (j - v.size as i64) % (v.size - v.loop_start) as i64;
+                } else {
+                    *o = 0.0;
+                    continue;
+                }
+            }
+            *o = fetch(v, mem, j as u32);
+        }
+    });
+    out / 128.0
+}
+
 fn fetch(v: &mut Voice, mem: &MemView, idx: u32) -> f32 {
     if !v.compressed {
         return mem.u8(v.data + idx).map_or(0.0, |b| b as i8 as f32);
@@ -795,21 +848,28 @@ fn fetch(v: &mut Voice, mem: &MemView, idx: u32) -> f32 {
     // unmodified; sample k (k>=1) reads byte 1+(k>>1), even k the high
     // nibble, odd k the low — byte 1's high nibble is never read.
     let blk = idx >> 6;
-    if blk != v.blk_idx {
+    let slot = if v.blk_idx[0] == blk {
+        0
+    } else if v.blk_idx[1] == blk {
+        1
+    } else {
         let Some(b) = mem.slice(v.data + blk * 33, 33) else {
             return 0.0;
         };
+        let slot = v.blk_next as usize;
+        v.blk_next ^= 1;
         let mut cur = b[0] as i8;
-        v.blk[0] = cur;
+        v.blk[slot][0] = cur;
         for k in 1..64usize {
             let byte = b[1 + (k >> 1)];
             let nib = if k & 1 == 0 { byte >> 4 } else { byte & 0xF };
             cur = cur.wrapping_add(DPCM_LUT[nib as usize]);
-            v.blk[k] = cur;
+            v.blk[slot][k] = cur;
         }
-        v.blk_idx = blk;
-    }
-    v.blk[(idx & 63) as usize] as f32
+        v.blk_idx[slot] = blk;
+        slot
+    };
+    v.blk[slot][(idx & 63) as usize] as f32
 }
 
