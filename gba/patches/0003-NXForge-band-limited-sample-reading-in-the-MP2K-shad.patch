 crates/gba-core/src/lib.rs    |   1 +
 crates/gba-core/src/mp2k.rs   |  89 ++++++++++++++++---
 3 files changed, 233 insertions(+), 13 deletions(-)
 create mode 100644 crates/gba-core/src/interp.rs

diff --git a/crates/gba-core/src/interp.rs b/crates/gba-core/src/interp.rs
new file mode 100644
index 0000000..b8bddea
--- /dev/null
+++ b/crates/gba-core/src/interp.rs
@@ -0,0 +1,156 @@
+//! NXForge: band-limited sample interpolation for the HLE shadow mixers.
+//!
+//! A shadow voice reads an instrument sample (8-bit, usually recorded at 8-22 kHz) at an arbitrary pitch and renders
+//! it on the 65536 Hz grid. Straight-line interpolation between neighbouring samples leaves mirror images of the
+//! instrument above its own Nyquist (the metallic fizz on top of GBA music), and a pitched-up note folds its top end
+//! back down as aliasing. This evaluates a Kaiser-windowed sinc instead, stretched when the voice plays faster than
+//! the grid so it also filters before it decimates.
+//!
+//! The kernel is centred on the read position, so it adds no delay: the samples ahead of the play head are already
+//! in memory. The weights are normalised by their own sum, so a constant input comes out exactly constant (no ripple
+//! from the window at any fractional phase).
+
+/// Kernel half-width in source samples at unity speed (16 taps in all).
+pub const HALF: usize = 8;
+/// Table resolution: entries per source sample.
+const RES: usize = 256;
+/// Cutoff as a fraction of the source rate (0.5 = Nyquist), slightly under so the transition band sits mostly
+/// above the sample's own content.
+const FC: f64 = 0.46;
+/// Kaiser window shape (about -70 dB stop band for this length).
+const BETA: f64 = 7.0;
+/// Fastest voice the kernel stretches for; beyond it (rare: a sample pitched up more than 4x past the grid rate)
+/// the kernel stays at this width and some aliasing is accepted rather than unbounded cost.
+const MAX_STRETCH: f64 = 4.0;
+
+fn bessel_i0(x: f64) -> f64 {
+    let (mut sum, mut term, mut k) = (1.0, 1.0, 1.0);
+    while term > 1e-12 * sum {
+        term *= (x / (2.0 * k)) * (x / (2.0 * k));
+        sum += term;
+        k += 1.0;
+    }
+    sum
+}
+
+fn table() -> &'static [f32] {
+    static TABLE: std::sync::OnceLock<Vec<f32>> = std::sync::OnceLock::new();
+    TABLE.get_or_init(|| {
+        use std::f64::consts::PI;
+        let n = HALF * RES;
+        let i0b = bessel_i0(BETA);
+        (0..=n + 1)
+            .map(|i| {
+                let x = i as f64 / RES as f64;
+                if x >= HALF as f64 {
+                    return 0.0;
+                }
+                let sinc = if x == 0.0 { 2.0 * FC } else { (2.0 * PI * FC * x).sin() / (PI * x) };
+                let r = x / HALF as f64;
+                let win = bessel_i0(BETA * (1.0 - r * r).max(0.0).sqrt()) / i0b;
+                (sinc * win) as f32
+            })
+            .collect()
+    })
+}
+
+#[inline(always)]
+fn kernel(t: &[f32], x: f32) -> f32 {
+    let p = x.abs() * RES as f32;
+    let i = p as usize;
+    if i >= HALF * RES {
+        return 0.0;
+    }
+    let f = p - i as f32;
+    t[i] + (t[i + 1] - t[i]) * f
+}
+
+/// The value at fractional source position `pos` of a voice moving `step` source samples per output sample.
+/// `window(lo, n)` fills `buf[..n]` with source samples `lo..lo + n` (zeros outside the sound, loop wrap applied by
+/// the caller) and is called once per output sample.
+#[inline]
+pub fn sample<F: FnMut(i64, &mut [f32])>(pos: f64, step: f64, buf: &mut [f32; 4 * HALF * 2 + 2], mut window: F) -> f32 {
+    let t = table();
+    let stretch = step.clamp(1.0, MAX_STRETCH);
+    let half = HALF as f64 * stretch;
+    let lo = (pos - half).floor() as i64 + 1;
+    let hi = (pos + half).ceil() as i64 - 1;
+    let n = ((hi - lo + 1).max(0) as usize).min(buf.len());
+    window(lo, &mut buf[..n]);
+    let inv = (1.0 / stretch) as f32;
+    let base = (lo as f64 - pos) as f32;
+    let (mut acc, mut wsum) = (0.0f32, 0.0f32);
+    for (k, s) in buf[..n].iter().enumerate() {
+        let w = kernel(t, (base + k as f32) * inv);
+        acc += w * s;
+        wsum += w;
+    }
+    if wsum.abs() > 1e-6 {
+        acc / wsum
+    } else {
+        0.0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn render(src: &[f32], step: f64, n: usize) -> Vec<f32> {
+        let mut buf = [0f32; 4 * HALF * 2 + 2];
+        (0..n)
+            .map(|i| {
+                sample(i as f64 * step, step, &mut buf, |lo, out| {
+                    for (k, o) in out.iter_mut().enumerate() {
+                        let j = lo + k as i64;
+                        *o = if j >= 0 && (j as usize) < src.len() { src[j as usize] } else { 0.0 };
+                    }
+                })
+            })
+            .collect()
+    }
+
+    #[test]
+    fn content_below_the_cutoff_passes_unchanged() {
+        // a tone at a fifth of the source rate, read at a third of a sample per step: every output lands on the tone
+        let src: Vec<f32> = (0..400).map(|i| 100.0 * (i as f32 * 0.2 * std::f32::consts::TAU).sin()).collect();
+        let out = render(&src, 1.0 / 3.0, 1200);
+        for (i, v) in out.iter().enumerate().take(1100).skip(60) {
+            let want = 100.0 * (i as f32 / 3.0 * 0.2 * std::f32::consts::TAU).sin();
+            assert!((v - want).abs() < 0.5, "{i}: {v} vs {want}");
+        }
+    }
+
+    #[test]
+    fn constant_stays_constant() {
+        let src = vec![50.0f32; 400];
+        for step in [0.13, 0.5, 1.0, 1.7, 3.3] {
+            let out = render(&src, step, (300.0 / step) as usize);
+            for (i, v) in out.iter().enumerate().take((250.0 / step) as usize).skip((40.0 / step) as usize) {
+                assert!((v - 50.0).abs() < 1e-3, "step {step} at {i}: {v}");
+            }
+        }
+    }
+
+    /// A tone at 3/8 of the source rate, played 4x slower (as an 8 kHz sample on a 32 kHz grid would be): the
+    /// interpolated output should hold the tone and almost nothing at its first mirror image.
+    #[test]
+    fn upsampling_suppresses_images() {
+        use std::f64::consts::PI;
+        let f = 0.375;
+        let src: Vec<f32> = (0..4096).map(|i| (2.0 * PI * f * i as f64).sin() as f32).collect();
+        let out = render(&src, 0.25, 8192);
+        let tone = |freq: f64| {
+            let (mut re, mut im) = (0.0, 0.0);
+            for (i, v) in out[1024..7168].iter().enumerate() {
+                let a = 2.0 * PI * freq * i as f64;
+                re += *v as f64 * a.cos();
+                im += *v as f64 * a.sin();
+            }
+            (re * re + im * im).sqrt()
+        };
+        let want = tone(f / 4.0);
+        let image = tone((1.0 - f) / 4.0);
+        assert!(image / want < 0.01, "image {:.4} of the tone", image / want);
+    }
+}
